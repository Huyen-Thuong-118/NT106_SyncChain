<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.ForgotPasswordPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Quên mật khẩu"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#17213145">
        <Image x:Name="BackgroundPhoto"
               Source="background_signin.jpg"
               Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
        <BoxView Color="#33213145" InputTransparent="True" />
        <ScrollView>
            <Grid Padding="24" MinimumHeightRequest="720">
                <Border MaximumWidthRequest="430"
                        HorizontalOptions="Center" VerticalOptions="Center"
                        BackgroundColor="#FAFFFFFF" Stroke="#FFFFFFFF" StrokeThickness="1" Padding="30">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#33213145" Offset="0,18" Radius="48" Opacity="0.45" /></Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        <VerticalStackLayout Spacing="8" Margin="0,0,0,8">
                            <Label Text="Quên mật khẩu"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   HorizontalTextAlignment="Center" />
                            <Label x:Name="SubtitleLabel"
                                   Text="Nhập email để nhận mã OTP đặt lại mật khẩu"
                                   Style="{StaticResource BodyMdLabel}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Border x:Name="ErrorBanner" IsVisible="False"
                                BackgroundColor="#FFF3F3" Stroke="#FFCDD5" StrokeThickness="1" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Label x:Name="ErrorLabel" TextColor="#B00020" FontFamily="Inter" FontSize="13" />
                        </Border>

                        <!-- Bước 1: nhập email -->
                        <VerticalStackLayout x:Name="Step1" Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="EMAIL" Style="{StaticResource LabelCapsLabel}" />
                                <Entry x:Name="EmailEntry" Style="{StaticResource MinimalistEntry}" Placeholder="email@example.com" Keyboard="Email" />
                                <Label x:Name="EmailError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                            </VerticalStackLayout>
                            <Button x:Name="SendOtpButton" Text="GỬI MÃ OTP" Style="{StaticResource PillPrimaryButton}" Clicked="OnSendOtpClicked" />
                        </VerticalStackLayout>

                        <!-- Bước 2: nhập OTP + mật khẩu mới -->
                        <VerticalStackLayout x:Name="Step2" IsVisible="False" Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="MÃ OTP (6 CHỮ SỐ)" Style="{StaticResource LabelCapsLabel}" />
                                <Entry x:Name="OtpEntry" Style="{StaticResource MinimalistEntry}" Placeholder="123456" Keyboard="Numeric" MaxLength="6" />
                                <Label x:Name="OtpError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="MẬT KHẨU MỚI" Style="{StaticResource LabelCapsLabel}" />
                                <Entry x:Name="NewPasswordEntry" Style="{StaticResource MinimalistEntry}" Placeholder="••••••••" IsPassword="True" />
                                <Label x:Name="NewPasswordError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="XÁC NHẬN MẬT KHẨU" Style="{StaticResource LabelCapsLabel}" />
                                <Entry x:Name="ConfirmPasswordEntry" Style="{StaticResource MinimalistEntry}" Placeholder="••••••••" IsPassword="True" />
                                <Label x:Name="ConfirmPasswordError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                            </VerticalStackLayout>
                            <Button x:Name="ResetButton" Text="ĐẶT LẠI MẬT KHẨU" Style="{StaticResource PillPrimaryButton}" Clicked="OnResetPasswordClicked" />
                            <Button Text="GỬI LẠI OTP" Style="{StaticResource PillSecondaryButton}" Clicked="OnSendOtpClicked" />
                        </VerticalStackLayout>

                        <Label Text="Quay lại đăng nhập"
                               TextColor="{DynamicResource Primary}"
                               FontFamily="Inter" FontSize="14"
                               HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
