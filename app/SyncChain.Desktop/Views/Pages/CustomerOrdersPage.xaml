<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.CustomerOrdersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:SyncChain.Desktop.Views.Pages"
             Title="Đơn hàng của tôi"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="48,30" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Đơn hàng của tôi"
                       FontSize="28" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1" Text="LÀM MỚI"
                        Style="{StaticResource PillSecondaryButton}"
                        Clicked="OnRefreshClicked" />
            </Grid>

            <Label x:Name="EmptyLabel"
                   Text="Bạn chưa có đơn hàng nào. Hãy khám phá sản phẩm và đặt đơn đầu tiên nhé!"
                   IsVisible="False"
                   TextColor="{StaticResource OnSurfaceVariant}" />

            <!-- BindableLayout (không phải CollectionView) để render an toàn bên trong ScrollView. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:CustomerOrderRow">
                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#22213145"
                                StrokeThickness="1"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Code}"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                                <Border Grid.Row="0" Grid.Column="1"
                                        BackgroundColor="{Binding StatusColor}"
                                        StrokeThickness="0" Padding="12,5"
                                        HorizontalOptions="End">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Date}"
                                       FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Total}"
                                       FontSize="16" FontAttributes="Bold"
                                       HorizontalOptions="End" />

                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="10" Margin="0,4,0,0">
                                    <Button Text="Chi tiết"
                                            Style="{StaticResource PillSecondaryButton}"
                                            CommandParameter="{Binding Id}"
                                            Clicked="OnDetailClicked" />
                                    <Button Text="Theo dõi"
                                            Style="{StaticResource PillPrimaryButton}"
                                            CommandParameter="{Binding Id}"
                                            Clicked="OnTrackClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
