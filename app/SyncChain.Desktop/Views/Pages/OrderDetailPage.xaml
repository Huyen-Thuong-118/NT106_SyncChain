<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.OrderDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView Background="{StaticResource AppPageBackgroundBrush}">
        <VerticalStackLayout Padding="30" Spacing="24">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button Text="← Quay lại danh sách" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="ĐƠN HÀNG #ORD-2023-8942" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="Được tạo vào 14/10/2023 lúc 10:24 AM" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="In hóa đơn" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="3" Text="Cập nhật trạng thái" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="18">
                <VerticalStackLayout Spacing="18">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Lines}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Sản phẩm trong đơn" Style="{StaticResource SectionTitleLabel}" />
                                <Label Grid.Column="1" Text="3 sản phẩm" Style="{StaticResource CaptionLabel}" />
                            </Grid>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="72,*,Auto,Auto" ColumnSpacing="14">
                                        <Border BackgroundColor="#E8EDF4" StrokeThickness="0" WidthRequest="62" HeightRequest="62">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{Binding Variant}" Style="{StaticResource CaptionLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Quantity}" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="{Binding Price}" VerticalTextAlignment="Center" FontAttributes="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Timeline}">
                            <Label Text="Lịch sử xử lý" Style="{StaticResource SectionTitleLabel}" />
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                                        <BoxView Color="{Binding Accent}" WidthRequest="12" HeightRequest="12" CornerRadius="6" VerticalOptions="Start" Margin="4,6,0,0" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                                            <Label Text="{Binding Time}" Style="{StaticResource CaptionLabel}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="18">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Thông tin khách hàng" Style="{StaticResource SectionTitleLabel}" />
                            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                                <Border BackgroundColor="#E8F1FF" StrokeThickness="0" WidthRequest="42" HeightRequest="42">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Label Text="NL" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Nguyễn Văn Lâm" FontAttributes="Bold" />
                                    <Label Text="lam.nv@gmail.com" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Số điện thoại" Style="{StaticResource CaptionLabel}" /><Label Grid.Column="1" Text="0901 234 567" FontAttributes="Bold" /></Grid>
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Địa chỉ giao hàng" Style="{StaticResource CaptionLabel}" /><Label Grid.Column="1" Text="12 Nguyễn Huệ, Quận 1, TP.HCM" FontAttributes="Bold" HorizontalTextAlignment="End" /></Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Tóm tắt thanh toán" Style="{StaticResource SectionTitleLabel}" />
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Tạm tính" /><Label Grid.Column="1" Text="1,450,000 đ" /></Grid>
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Phí vận chuyển" /><Label Grid.Column="1" Text="30,000 đ" /></Grid>
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Giảm giá" /><Label Grid.Column="1" Text="-30,000 đ" /></Grid>
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Tổng cộng" FontAttributes="Bold" /><Label Grid.Column="1" Text="1,450,000 đ" FontAttributes="Bold" /></Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Ghi chú đơn hàng" Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="Khách yêu cầu giao trong giờ hành chính. Kiểm tra kỹ sản phẩm trước khi đóng gói." Style="{StaticResource CaptionLabel}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
