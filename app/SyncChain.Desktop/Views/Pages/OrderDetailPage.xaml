<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.OrderDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">
            <!-- Header giống giao diện cũ -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">
                <Button Text="← QUAY LẠI"
                        Style="{StaticResource PillSecondaryButton}"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                    <Label Text="{Binding OrderCode}"
                           Style="{StaticResource DisplayXlLabel}"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding OrderDate}"
                           Style="{StaticResource BodyMdLabel}" />
                </VerticalStackLayout>
                <Border Grid.Column="2"
                        BackgroundColor="{Binding OrderStatusColor}"
                        StrokeThickness="0"
                        Padding="12,7"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding OrderStatus}"
                           FontAttributes="Bold"
                           FontSize="12" />
                </Border>
                <Button Grid.Column="3"
                        Text="IN HÓA ĐƠN"
                        Style="{StaticResource PillSecondaryButton}"
                        Clicked="OnPrintInvoiceClicked" />
                <Button Grid.Column="4"
                        Text="{Binding PrimaryActionText}"
                        Style="{StaticResource PillPrimaryButton}"
                        IsVisible="{Binding HasPrimaryAction}"
                        Clicked="OnPrimaryActionClicked" />
                <Button Grid.Column="5"
                        Text="HỦY ĐƠN"
                        Style="{StaticResource PillSecondaryButton}"
                        IsVisible="{Binding CanCancel}"
                        Clicked="OnCancelOrderClicked" />
            </Grid>

            <!-- Bố cục hai cột giống trước -->
            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="24">
                <VerticalStackLayout Grid.Column="0" Spacing="24">
                    <!-- Danh sách sản phẩm -->
                    <Border Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Sản phẩm trong đơn"
                                       Style="{StaticResource HeadlineLgMobileLabel}"
                                       FontSize="24" />
                                <Label Grid.Column="1"
                                       Text="{Binding ProductCount}"
                                       Style="{StaticResource BodyMdLabel}"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="12">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:LineItem">
                                        <Grid ColumnDefinitions="72,*,90,130"
                                              ColumnSpacing="14"
                                              MinimumHeightRequest="66">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                                    StrokeThickness="0"
                                                    WidthRequest="62"
                                                    HeightRequest="62">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Initials}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource Primary}"
                                                       FontSize="16" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center"
                                                                 Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       Style="{StaticResource DataTabularLabel}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Variant}"
                                                       Style="{StaticResource BodyMdLabel}"
                                                       FontSize="13"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2"
                                                                 VerticalOptions="Center"
                                                                 Spacing="3">
                                                <Label Text="SỐ LƯỢNG"
                                                       Style="{StaticResource LabelCapsLabel}"
                                                       FontSize="10" />
                                                <Label Text="{Binding Quantity}"
                                                       Style="{StaticResource DataTabularLabel}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="3"
                                                                 VerticalOptions="Center"
                                                                 Spacing="3">
                                                <Label Text="ĐƠN GIÁ"
                                                       Style="{StaticResource LabelCapsLabel}"
                                                       FontSize="10" />
                                                <Label Text="{Binding Price}"
                                                       Style="{StaticResource DataTabularLabel}"
                                                       LineBreakMode="NoWrap" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lịch sử vận chuyển -->
                    <Border Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="Lịch sử vận chuyển"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   FontSize="24" />
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timeline}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TimelineItem">
                                        <Grid ColumnDefinitions="32,*"
                                              ColumnSpacing="16"
                                              Padding="0,8">
                                            <VerticalStackLayout Grid.Column="0"
                                                                 HorizontalOptions="Center">
                                                <Border WidthRequest="16"
                                                        HeightRequest="16"
                                                        BackgroundColor="{Binding Accent}"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                </Border>
                                                <BoxView WidthRequest="2"
                                                         HeightRequest="32"
                                                         Color="{DynamicResource OutlineVariant}"
                                                         HorizontalOptions="Center"
                                                         IsVisible="{Binding ShowConnector}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="4"
                                                                 VerticalOptions="Start">
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource DataTabularLabel}"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Time}"
                                                       Style="{StaticResource BodyMdLabel}"
                                                       FontSize="13"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="24">
                    <!-- Thông tin khách hàng -->
                    <Border Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Thông tin khách hàng"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   FontSize="24" />
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource SurfaceContainerHigh}"
                                        StrokeThickness="0"
                                        WidthRequest="42"
                                        HeightRequest="42">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding CustomerInitials}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource Primary}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding CustomerName}"
                                           Style="{StaticResource DataTabularLabel}"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding CustomerEmail}"
                                           Style="{StaticResource BodyMdLabel}"
                                           FontSize="13"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Mỗi thông tin nằm ở một hàng riêng -->
                            <Grid ColumnDefinitions="140,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="14"
                                  RowSpacing="14">
                                <Label Grid.Row="0"
                                       Text="Số điện thoại"
                                       Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding CustomerPhone}"
                                       Style="{StaticResource DataTabularLabel}"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="WordWrap" />
                                <Label Grid.Row="1"
                                       Text="Địa chỉ giao hàng"
                                       Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding CustomerAddress}"
                                       Style="{StaticResource DataTabularLabel}"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Thanh toán -->
                    <Border Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Tóm tắt thanh toán"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   FontSize="24" />
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,1,Auto"
                                  RowSpacing="12">
                                <Label Grid.Row="0"
                                       Text="Tạm tính"
                                       Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Subtotal}"
                                       Style="{StaticResource DataTabularLabel}" />
                                <Label Grid.Row="1"
                                       Text="Phí vận chuyển"
                                       Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding ShippingFee}"
                                       Style="{StaticResource DataTabularLabel}" />
                                <BoxView Grid.Row="2"
                                         Grid.ColumnSpan="2"
                                         Color="{DynamicResource OutlineVariant}" />
                                <Label Grid.Row="3"
                                       Text="Tổng cộng"
                                       Style="{StaticResource DataTabularLabel}"
                                       FontSize="16" />
                                <Label Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding TotalAmount}"
                                       Style="{StaticResource DataTabularLabel}"
                                       FontSize="18" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ghi chú đơn hàng giống trước, kèm ETA -->
                    <Border Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Ghi chú đơn hàng"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   FontSize="24" />
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                            <Label Text="{Binding OrderNote}"
                                   Style="{StaticResource BodyMdLabel}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Thông tin vận chuyển"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   FontSize="24" />
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                            <Grid ColumnDefinitions="140,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="14"
                                  RowSpacing="12">
                                <Label Grid.Row="0" Text="Đơn vị" Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Carrier}"
                                       Style="{StaticResource DataTabularLabel}" LineBreakMode="WordWrap" />
                                <Label Grid.Row="1" Text="Mã vận đơn" Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding TrackingNumber}"
                                       Style="{StaticResource DataTabularLabel}" LineBreakMode="WordWrap" />
                                <Label Grid.Row="2" Text="Ngày dự kiến" Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding EstimatedDelivery}"
                                       Style="{StaticResource DataTabularLabel}" LineBreakMode="WordWrap" />
                
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
