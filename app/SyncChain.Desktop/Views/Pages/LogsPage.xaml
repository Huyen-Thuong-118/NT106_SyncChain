<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 PAGE HEADER
                 "Nhật ký Hoạt động" in DisplayXlLabel + "Xuất nhật ký" PillPrimaryButton
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Nhật ký Hoạt động" Style="{StaticResource DisplayXlLabel}" />
                    <Label Text="Theo dõi các thao tác quan trọng trong hệ thống." Style="{StaticResource BodyMdLabel}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="XUẤT NHẬT KÝ" Style="{StaticResource PillPrimaryButton}" VerticalOptions="Center" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 FILTER BAR
                 GlassCardBorder with search + filter buttons
            ═══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource GlassCardBorder}">
                <Grid ColumnDefinitions="2*,Auto,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border BackgroundColor="{DynamicResource SurfaceContainerLowest}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="14,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" HeightRequest="42">
                            <Label Text="⌕" VerticalTextAlignment="Center" TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Entry Grid.Column="1" Placeholder="Tìm kiếm..." Style="{StaticResource MinimalistEntry}" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Text="VAI TRÒ ▾" Style="{StaticResource PillSecondaryButton}" Padding="14,10" />
                    <Button Grid.Column="2" Text="HOẠT ĐỘNG ▾" Style="{StaticResource PillSecondaryButton}" Padding="14,10" />
                    <Button Grid.Column="3" Text="30 NGÀY ▾" Style="{StaticResource PillSecondaryButton}" Padding="14,10" />
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 STATISTICS CARDS
                 3-column grid with GlassCardBorder containers
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="HOẠT ĐỘNG HÔM NAY" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="128" Style="{StaticResource DataTabularLabel}" FontSize="28" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="THAY ĐỔI DỮ LIỆU" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="42" Style="{StaticResource DataTabularLabel}" FontSize="28" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="CẢNH BÁO" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="06" Style="{StaticResource DataTabularLabel}" FontSize="28" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 LOG TABLE
                 GlassCardBorder with column headers + log entry rows
            ═══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <!-- Table title -->
                    <Label Text="Chi tiết nhật ký" Style="{StaticResource DataTabularLabel}" FontSize="17" />

                    <!-- Table header -->
                    <Grid ColumnDefinitions="52,2*,2.5*,1.2*,1.2*" ColumnSpacing="14" Padding="8,0">
                        <Label Text="" WidthRequest="52" />
                        <Label Grid.Column="1" Text="Hành động" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2" Text="Mô tả" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="3" Text="Thời gian" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="4" Text="Loại" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                    </Grid>
                    <!-- Separator -->
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <!-- Log entry rows -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Logs}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:LogItem">
                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="8,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="52,2*,2.5*,1.2*,1.2*" ColumnSpacing="14">
                                        <!-- Icon container -->
                                        <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="46" HeightRequest="46">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" />
                                        </Border>
                                        <!-- Hành động (Title) -->
                                        <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource DataTabularLabel}"
                                               VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <!-- Mô tả (Description) -->
                                        <Label Grid.Column="2" Text="{Binding Description}" Style="{StaticResource DataTabularLabel}"
                                               FontAttributes="None" TextColor="{DynamicResource OnSurfaceVariant}"
                                               VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <!-- Thời gian (Time) -->
                                        <Label Grid.Column="3" Text="{Binding Time}" Style="{StaticResource DataTabularLabel}"
                                               FontAttributes="None" TextColor="{DynamicResource OnSurfaceVariant}"
                                               VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <!-- Loại (Tag) - StatusBadgePill -->
                                        <Border Grid.Column="4" BackgroundColor="{Binding Accent}" StrokeThickness="0"
                                                Padding="12,4" HorizontalOptions="Start" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Tag}" Style="{StaticResource StatusBadgePill}" TextColor="White" Padding="0" LineBreakMode="TailTruncation" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Pagination -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="Hiển thị 1 – 5 trong số 2,481 hoạt động" Style="{StaticResource BodyMdLabel}" VerticalTextAlignment="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <Button Text="TRƯỚC" Style="{StaticResource PillSecondaryButton}" Padding="18,10" />
                            <Button Text="1" Style="{StaticResource PillPrimaryButton}" Padding="14,10" />
                            <Button Text="2" Style="{StaticResource PillSecondaryButton}" Padding="14,10" />
                            <Button Text="3" Style="{StaticResource PillSecondaryButton}" Padding="14,10" />
                            <Button Text="TIẾP" Style="{StaticResource PillSecondaryButton}" Padding="18,10" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

