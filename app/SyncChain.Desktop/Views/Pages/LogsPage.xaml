<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="64,30" Spacing="24">
                <Border Style="{StaticResource PageHeaderCard}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout>
                        <Label Text="Nhật ký hoạt động" Style="{StaticResource DisplayXlLabel}" />
                        <Label Text="Theo dõi thao tác, kết quả và thay đổi dữ liệu trong hệ thống."
                               Style="{StaticResource BodyMdLabel}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="TẢI LẠI"
                            Style="{StaticResource PillSecondaryButton}"
                            Clicked="OnReloadClicked" />
                </Grid>
                </Border>

                <Border Style="{StaticResource GlassCardBorder}">
                    <Grid ColumnDefinitions="2*,1*,1.2*,1*,Auto"
                          ColumnSpacing="12">
                        <Entry x:Name="SearchEntry"
                               Placeholder="Tìm người dùng, đối tượng hoặc mã..."
                               TextChanged="OnSearchChanged" />
                        <Picker x:Name="RolePicker"
                                Grid.Column="1"
                                Title="Vai trò"
                                SelectedIndex="0"
                                SelectedIndexChanged="OnFilterChanged">
                            <Picker.Items>
                                <x:String>Tất cả vai trò</x:String>
                                <x:String>Admin</x:String>
                                <x:String>Manager</x:String>
                                <x:String>Staff</x:String>
                                <x:String>Customer</x:String>
                            </Picker.Items>
                        </Picker>
                        <Picker x:Name="ActionPicker"
                                Grid.Column="2"
                                Title="Hoạt động"
                                SelectedIndex="0"
                                SelectedIndexChanged="OnFilterChanged">
                            <Picker.Items>
                                <x:String>Tất cả hoạt động</x:String>
                                <x:String>Đăng nhập</x:String>
                                <x:String>Tạo mới</x:String>
                                <x:String>Cập nhật</x:String>
                                <x:String>Đổi trạng thái</x:String>
                                <x:String>Đổi vai trò</x:String>
                                <x:String>Đổi mật khẩu</x:String>
                                <x:String>Điều chỉnh kho</x:String>
                            </Picker.Items>
                        </Picker>
                        <Picker x:Name="ResultPicker"
                                Grid.Column="3"
                                Title="Kết quả"
                                SelectedIndex="0"
                                SelectedIndexChanged="OnFilterChanged">
                            <Picker.Items>
                                <x:String>Tất cả kết quả</x:String>
                                <x:String>Thành công</x:String>
                                <x:String>Thất bại</x:String>
                            </Picker.Items>
                        </Picker>
                        <Button Grid.Column="4" Text="XÓA LỌC"
                                Style="{StaticResource PillSecondaryButton}"
                                Clicked="OnClearFiltersClicked" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
                    <Border Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout>
                            <Label Text="HOẠT ĐỘNG HÔM NAY" Style="{StaticResource LabelCapsLabel}" />
                            <Label Text="{Binding TodayActivities}" Style="{StaticResource DataTabularLabel}" FontSize="28" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout>
                            <Label Text="THAY ĐỔI DỮ LIỆU" Style="{StaticResource LabelCapsLabel}" />
                            <Label Text="{Binding DataChanges}" Style="{StaticResource DataTabularLabel}" FontSize="28" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}">
                        <VerticalStackLayout>
                            <Label Text="THẤT BẠI / CẢNH BÁO" Style="{StaticResource LabelCapsLabel}" />
                            <Label Text="{Binding Warnings}" Style="{StaticResource DataTabularLabel}" FontSize="28" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="1.5*,1.2*,1.4*,1.1*,0.8*,76"
                              ColumnSpacing="12" Padding="8,0">
                            <Label Text="HÀNH ĐỘNG" Style="{StaticResource LabelCapsLabel}" />
                            <Label Grid.Column="1" Text="NGƯỜI DÙNG" Style="{StaticResource LabelCapsLabel}" />
                            <Label Grid.Column="2" Text="ĐỐI TƯỢNG" Style="{StaticResource LabelCapsLabel}" />
                            <Label Grid.Column="3" Text="THỜI GIAN" Style="{StaticResource LabelCapsLabel}" />
                            <Label Grid.Column="4" Text="KẾT QUẢ" Style="{StaticResource LabelCapsLabel}" />
                            <Label Grid.Column="5" Text="CHI TIẾT" Style="{StaticResource LabelCapsLabel}"
                                   HorizontalTextAlignment="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Logs}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:LogItem">
                                    <Border BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                            StrokeThickness="0" Padding="10,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="1.5*,1.2*,1.4*,1.1*,0.8*,76"
                                              ColumnSpacing="12">
                                            <HorizontalStackLayout Spacing="10">
                                                <Border WidthRequest="34" HeightRequest="34"
                                                        BackgroundColor="{Binding Accent}" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Icon}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           FontSize="13" TextColor="White" />
                                                </Border>
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource DataTabularLabel}"
                                                       VerticalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Description}"
                                                   Style="{StaticResource BodyMdLabel}"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding Tag}"
                                                   Style="{StaticResource BodyMdLabel}"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="3" Text="{Binding Time}"
                                                   Style="{StaticResource BodyMdLabel}"
                                                   VerticalTextAlignment="Center" />
                                            <Label Grid.Column="4" Text="{Binding ResultText}"
                                                   TextColor="{Binding Accent}"
                                                   FontAttributes="Bold"
                                                   VerticalTextAlignment="Center" />
                                            <Button Grid.Column="5" Text="⋮"
                                                    Style="{StaticResource PillSecondaryButton}"
                                                    WidthRequest="46" HeightRequest="42"
                                                    Padding="0" FontSize="22"
                                                    CommandParameter="{Binding Id}"
                                                    Clicked="OnViewDetailClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Không có nhật ký phù hợp."
                               IsVisible="{Binding IsEmpty}"
                               Style="{StaticResource BodyMdLabel}"
                               HorizontalTextAlignment="Center" Margin="0,20" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="{Binding PaginationText}"
                                   Style="{StaticResource BodyMdLabel}"
                                   VerticalTextAlignment="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Button Text="TRƯỚC"
                                        IsEnabled="{Binding CanGoPrevious}"
                                        Style="{StaticResource PillSecondaryButton}"
                                        Clicked="OnPreviousClicked" />
                                <Button Text="{Binding CurrentPageText}"
                                        Style="{StaticResource PillPrimaryButton}"
                                        IsEnabled="False" />
                                <Button Text="TIẾP"
                                        IsEnabled="{Binding CanGoNext}"
                                        Style="{StaticResource PillSecondaryButton}"
                                        Clicked="OnNextClicked" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsDetailOpen}"
              BackgroundColor="#99000000"
              Padding="90,55"
              ZIndex="10">
            <Border BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeThickness="1" Padding="24"
                    MaximumWidthRequest="1050"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,*" RowSpacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Chi tiết nhật ký"
                                   Style="{StaticResource HeadlineLgMobileLabel}" FontSize="25" />
                            <Label Text="{Binding DetailSummary}"
                                   Style="{StaticResource BodyMdLabel}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×"
                                Style="{StaticResource PillSecondaryButton}"
                                FontSize="20" Padding="14,8"
                                Clicked="OnCloseDetailClicked" />
                    </Grid>
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                <VerticalStackLayout>
                                    <Label Text="NGƯỜI DÙNG / VAI TRÒ" Style="{StaticResource LabelCapsLabel}" />
                                    <Label Text="{Binding DetailUser}" Style="{StaticResource DataTabularLabel}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="IP / THIẾT BỊ" Style="{StaticResource LabelCapsLabel}" />
                                    <Label Text="{Binding DetailDevice}" Style="{StaticResource BodyMdLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                <VerticalStackLayout>
                                    <Label Text="TRACE ID" Style="{StaticResource LabelCapsLabel}" />
                                    <Label Text="{Binding DetailTrace}" Style="{StaticResource BodyMdLabel}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="THỜI GIAN" Style="{StaticResource LabelCapsLabel}" />
                                    <Label Text="{Binding DetailTime}" Style="{StaticResource DataTabularLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="DỮ LIỆU TRƯỚC" Style="{StaticResource LabelCapsLabel}" />
                            <Editor Text="{Binding DetailBefore}" IsReadOnly="True" AutoSize="TextChanges" />
                            <Label Text="DỮ LIỆU SAU" Style="{StaticResource LabelCapsLabel}" />
                            <Editor Text="{Binding DetailAfter}" IsReadOnly="True" AutoSize="TextChanges" />
                            <Label Text="METADATA" Style="{StaticResource LabelCapsLabel}" />
                            <Editor Text="{Binding DetailMetadata}" IsReadOnly="True" AutoSize="TextChanges" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
