<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.OrderTrackingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,40" Spacing="24" MaximumWidthRequest="680"
                             HorizontalOptions="Center">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Button Text="← Quay lại" Style="{StaticResource PillSecondaryButton}"
                        Clicked="OnBackClicked" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label x:Name="OrderCodeLabel" Style="{StaticResource DisplayXlLabel}" />
                    <Label x:Name="OrderDateLabel" Style="{StaticResource BodyMdLabel}" />
                </VerticalStackLayout>
                <Button x:Name="PayButton" Grid.Column="2" Text="THANH TOÁN"
                        Style="{StaticResource PillPrimaryButton}"
                        Clicked="OnPayClicked" IsVisible="False" VerticalOptions="Center" />
            </Grid>

            <!-- Trạng thái & Phương thức -->
            <Border Style="{StaticResource GlassCardBorder}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="32">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="TRẠNG THÁI" Style="{StaticResource LabelCapsLabel}" />
                        <Border x:Name="StatusBadge" StrokeThickness="0" Padding="14,6" HorizontalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Label x:Name="StatusLabel" Style="{StaticResource StatusBadgePill}" Padding="0" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="THANH TOÁN" Style="{StaticResource LabelCapsLabel}" />
                        <Label x:Name="PaymentLabel" Style="{StaticResource DataTabularLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Timeline -->
            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Tiến trình đơn hàng" Style="{StaticResource HeadlineLgMobileLabel}" FontSize="20" />
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <VerticalStackLayout x:Name="TimelineStack" Spacing="0" />
                </VerticalStackLayout>
            </Border>

            <!-- Địa chỉ giao hàng -->
            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Địa chỉ giao hàng" Style="{StaticResource HeadlineLgMobileLabel}" FontSize="20" />
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <Label x:Name="RecipientLabel" Style="{StaticResource DataTabularLabel}" />
                    <Label x:Name="AddressLabel" Style="{StaticResource BodyMdLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Danh sách sản phẩm -->
            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Sản phẩm" Style="{StaticResource HeadlineLgMobileLabel}" FontSize="20" />
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <VerticalStackLayout x:Name="ProductStack" Spacing="10" />
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Tổng cộng" Style="{StaticResource DataTabularLabel}" FontSize="16" VerticalTextAlignment="Center" />
                        <Label x:Name="TotalLabel" Grid.Column="1" Style="{StaticResource DataTabularLabel}" FontSize="18"
                               TextColor="{DynamicResource Primary}" VerticalTextAlignment="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
