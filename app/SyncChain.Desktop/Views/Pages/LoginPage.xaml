<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Đăng nhập"
             NavigationPage.HasNavigationBar="False">
    <Grid Padding="24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06080D" Offset="0.00" />
                <GradientStop Color="#0A1222" Offset="0.38" />
                <GradientStop Color="#101A31" Offset="0.72" />
                <GradientStop Color="#05070B" Offset="1.00" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#17356A"
                Opacity="0.28"
                WidthRequest="440"
                HeightRequest="440"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                TranslationX="-120">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="220" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#3B82F6"
                        Opacity="0.55"
                        Radius="120"
                        Offset="0,0" />
            </Border.Shadow>
        </Border>

        <Border Background="#0EA5E9"
                Opacity="0.10"
                WidthRequest="260"
                HeightRequest="260"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="80"
                TranslationY="-40">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="130" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#38BDF8"
                        Opacity="0.35"
                        Radius="90"
                        Offset="0,0" />
            </Border.Shadow>
        </Border>

        <Border BackgroundColor="{StaticResource SurfaceColor}"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="1080"
                MinimumHeightRequest="620">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="1.02*,0.98*">
                <Grid BackgroundColor="{StaticResource SidebarColor}"
                      Padding="36,28"
                      RowDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource SidebarAccentColor}"
                                StrokeThickness="0"
                                WidthRequest="42"
                                HeightRequest="42">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="∿"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                        </Border>

                        <Label Text="SUPPLY CHAIN"
                               VerticalTextAlignment="Center"
                               TextColor="White"
                               FontAttributes="Bold"
                               CharacterSpacing="1.8" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Grid.Row="1"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="18">
                        <Label Text="TVT Logistic"
                               TextColor="White"
                               FontSize="40"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <BoxView HeightRequest="4"
                                 WidthRequest="116"
                                 Color="White"
                                 HorizontalOptions="Center" />

                        <Label Text="Hệ thống quản lý chuỗi cung ứng hiện đại, chính xác và hiệu quả cao."
                               TextColor="#D7E6FF"
                               FontSize="16"
                               MaximumWidthRequest="360"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Row="2" Spacing="10">
                        <Label Text="v1.0.0" TextColor="{StaticResource SidebarMutedColor}" />
                        <Label Text="•" TextColor="{StaticResource SidebarMutedColor}" />
                    </HorizontalStackLayout>
                </Grid>

                <ScrollView Grid.Column="1">
                    <Grid Padding="40,36">
                        <VerticalStackLayout Spacing="18"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             MaximumWidthRequest="420">
                            <Label Text="Đăng nhập" Style="{StaticResource PageTitleLabel}" />
                            <Label Text="VUI LÒNG NHẬP THÔNG TIN TÀI KHOẢN" Style="{StaticResource CaptionLabel}" />

                            <VerticalStackLayout Spacing="8">
                                <Label Text="TÊN ĐĂNG NHẬP" Style="{StaticResource CaptionLabel}" />
                                <Border BackgroundColor="White"
                                        Stroke="{StaticResource BorderColor}"
                                        StrokeThickness="1"
                                        Padding="14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12"
                                          HeightRequest="46">
                                        <Label Text="◦"
                                               VerticalTextAlignment="Center"
                                               TextColor="{StaticResource MutedColor}" />
                                        <Entry Grid.Column="1"
                                               Placeholder="Nhập tên đăng nhập"
                                               BackgroundColor="Transparent" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="MẬT KHẨU" Style="{StaticResource CaptionLabel}" />
                                <Border BackgroundColor="White"
                                        Stroke="{StaticResource BorderColor}"
                                        StrokeThickness="1"
                                        Padding="14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12"
                                          HeightRequest="46">
                                        <Label Text="□"
                                               VerticalTextAlignment="Center"
                                               TextColor="{StaticResource MutedColor}" />
                                        <Entry Grid.Column="1"
                                               Placeholder="••••••••"
                                               IsPassword="True"
                                               BackgroundColor="Transparent" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <CheckBox IsChecked="True" />
                                <Label Grid.Column="1"
                                       Text="Ghi nhớ đăng nhập"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="2"
                                       Text="Quên mật khẩu?"
                                       TextColor="{StaticResource PrimaryColor}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End" />
                            </Grid>

                            <Button Text="ĐĂNG NHẬP QUẢN TRỊ"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Clicked="OnLoginClicked" />

                            <Button Text="ĐĂNG NHẬP KHÁCH HÀNG"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Clicked="OnCustomerLoginClicked" />

                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Label Text="Chưa có tài khoản?" />
                                <Label Text="Đăng ký"
                                       TextColor="{StaticResource PrimaryColor}"
                                       FontAttributes="Bold">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRegisterClicked" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>

                            <Label Text="2026 - TVT Logistic"
                                   HorizontalOptions="Center"
                                   Style="{StaticResource CaptionLabel}"
                                   Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
