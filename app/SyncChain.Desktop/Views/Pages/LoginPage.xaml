<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Đăng nhập"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid HorizontalOptions="Center"
              VerticalOptions="Center"
              Padding="24">

            <Border Style="{StaticResource GlassCardBorder}"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <VerticalStackLayout Spacing="20">

                    <!-- Header -->
                    <VerticalStackLayout Spacing="8" Margin="0,0,0,12">
                        <Label Text="Đăng nhập"
                               Style="{StaticResource HeadlineLgMobileLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Vui lòng nhập thông tin tài khoản"
                               Style="{StaticResource BodyMdLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Username field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="TÊN ĐĂNG NHẬP"
                               Style="{StaticResource LabelCapsLabel}" />
                        <Entry Style="{StaticResource MinimalistEntry}"
                               Placeholder="Nhập tên đăng nhập" />
                    </VerticalStackLayout>

                    <!-- Password field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="MẬT KHẨU"
                               Style="{StaticResource LabelCapsLabel}" />
                        <Entry Style="{StaticResource MinimalistEntry}"
                               Placeholder="••••••••"
                               IsPassword="True" />
                    </VerticalStackLayout>

                    <!-- Remember me + Forgot password -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <CheckBox IsChecked="True"
                                  Color="{DynamicResource Primary}" />
                        <Label Grid.Column="1"
                               Text="Ghi nhớ đăng nhập"
                               Style="{StaticResource BodyMdLabel}"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Column="2"
                               Text="Quên mật khẩu?"
                               TextColor="{DynamicResource Primary}"
                               FontFamily="Inter"
                               FontSize="14"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <!-- Login buttons -->
                    <Button Text="ĐĂNG NHẬP QUẢN TRỊ"
                            Style="{StaticResource PillPrimaryButton}"
                            Clicked="OnLoginClicked" />

                    <Button Text="ĐĂNG NHẬP KHÁCH HÀNG"
                            Style="{StaticResource PillSecondaryButton}"
                            Clicked="OnCustomerLoginClicked" />

                    <!-- Register link -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8,0,0">
                        <Label Text="Chưa có tài khoản?"
                               Style="{StaticResource BodyMdLabel}"
                               VerticalTextAlignment="Center" />
                        <Label Text="Đăng ký"
                               TextColor="{DynamicResource Primary}"
                               FontFamily="Inter"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Footer -->
                    <Label Text="2026 - SyncChain"
                           Style="{StaticResource LabelCapsLabel}"
                           HorizontalTextAlignment="Center"
                           Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
