<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Đăng nhập"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#17213145">
        <Image x:Name="BackgroundPhoto"
               Source="background_signin.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True" />
        <BoxView Color="#33213145" InputTransparent="True" />

        <ScrollView Background="Transparent" BackgroundColor="Transparent">
            <Grid Padding="24" MinimumHeightRequest="720">
                <Border MaximumWidthRequest="430"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="#FAFFFFFF"
                        Stroke="#FFFFFFFF"
                        StrokeThickness="1"
                        Padding="30">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#33213145" Offset="0,18" Radius="48" Opacity="0.45" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        <VerticalStackLayout Spacing="8" Margin="0,0,0,12">
                            <Label Text="Đăng nhập"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   TextColor="{DynamicResource OnSurface}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Vui lòng nhập thông tin tài khoản"
                                   Style="{StaticResource BodyMdLabel}"
                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="EMAIL" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="EmailEntry"
                                   Style="{StaticResource MinimalistEntry}"
                                   Placeholder="abc@gmail.com"
                                   Keyboard="Email" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="MẬT KHẨU" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="PasswordEntry"
                                   Style="{StaticResource MinimalistEntry}"
                                   Placeholder="••••••••"
                                   IsPassword="True" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <CheckBox IsChecked="True" Color="{DynamicResource Primary}" />
                                <Label Grid.Column="1"
                                       Text="Ghi nhớ đăng nhập"
                                       Style="{StaticResource BodyMdLabel}"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <Button Text="ĐĂNG NHẬP QUẢN TRỊ"
                                Style="{StaticResource PillPrimaryButton}"
                                Clicked="OnLoginClicked" />

                        <Button Text="ĐĂNG NHẬP KHÁCH HÀNG"
                                Style="{StaticResource PillSecondaryButton}"
                                Clicked="OnCustomerLoginClicked" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8,0,0">
                            <Label Text="Chưa có tài khoản?"
                                   Style="{StaticResource BodyMdLabel}"
                                   VerticalTextAlignment="Center" />
                            <Label Text="Đăng ký"
                                   TextColor="{DynamicResource Primary}"
                                   FontFamily="Inter"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRegisterClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <Label Text="2026 - SyncChain"
                               Style="{StaticResource LabelCapsLabel}"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
