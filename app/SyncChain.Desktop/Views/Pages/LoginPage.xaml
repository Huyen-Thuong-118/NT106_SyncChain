<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Đăng nhập"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#17213145">
        <Image x:Name="BackgroundPhoto"
               Source="background_signin.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True" />
        <BoxView Color="#33213145"
                 InputTransparent="True" />
        <ScrollView Background="Transparent" BackgroundColor="Transparent">
            <Grid Padding="24"
                  MinimumHeightRequest="720">

                <Border MaximumWidthRequest="430"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="#FAFFFFFF"
                        Stroke="#FFFFFFFF"
                        StrokeThickness="1"
                        Padding="30">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#33213145" Offset="0,18" Radius="48" Opacity="0.45" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout Spacing="8" Margin="0,0,0,12">
                            <Label Text="Đăng nhập"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   TextColor="{DynamicResource OnSurface}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Nhập email, tên đăng nhập hoặc số điện thoại"
                                   Style="{StaticResource BodyMdLabel}"
                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Thông báo lỗi chung -->
                        <Border x:Name="GeneralError"
                                IsVisible="False"
                                BackgroundColor="#FFF3F3"
                                Stroke="#FFCDD5"
                                StrokeThickness="1"
                                Padding="12,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label x:Name="GeneralErrorLabel"
                                   TextColor="#B00020"
                                   FontFamily="Inter"
                                   FontSize="13" />
                        </Border>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="TÊN ĐĂNG NHẬP / EMAIL / SĐT"
                                   Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="IdentifierEntry"
                                   Style="{StaticResource MinimalistEntry}"
                                   Placeholder="Nhập email, tên tài khoản hoặc số điện thoại"
                                   ReturnType="Next" />
                            <Label x:Name="IdentifierError"
                                   IsVisible="False"
                                   TextColor="#B00020"
                                   FontFamily="Inter"
                                   FontSize="12" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="MẬT KHẨU" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="PasswordEntry"
                                   Style="{StaticResource MinimalistEntry}"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding Source={x:Reference LoginButton}, Path=Command}" />
                            <Label x:Name="PasswordError"
                                   IsVisible="False"
                                   TextColor="#B00020"
                                   FontFamily="Inter"
                                   FontSize="12" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Quên mật khẩu?"
                                   TextColor="{DynamicResource Primary}"
                                   FontFamily="Inter"
                                   FontSize="14"
                                   HorizontalTextAlignment="End">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnForgotPasswordClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>

                        <Button x:Name="LoginButton"
                                Text="ĐĂNG NHẬP"
                                Style="{StaticResource PillPrimaryButton}"
                                Clicked="OnLoginClicked" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8,0,0">
                            <Label Text="Chưa có tài khoản?"
                                   Style="{StaticResource BodyMdLabel}"
                                   VerticalTextAlignment="Center" />
                            <Label Text="Đăng ký"
                                   TextColor="{DynamicResource Primary}"
                                   FontFamily="Inter"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRegisterClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <Label Text="2026 - SyncChain"
                               Style="{StaticResource LabelCapsLabel}"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,0" />

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
