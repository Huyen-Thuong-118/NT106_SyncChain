<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False"
             Padding="0">

    <Grid ColumnDefinitions="320,*" ColumnSpacing="0">

        <!-- ═══════════════════════════════════════════════════════════════
             LEFT PANEL: Chat List (fixed 320px width)
             "Hộp thư" header, search input, conversation cards
        ═══════════════════════════════════════════════════════════════ -->
        <Border Style="{StaticResource GlassCardBorder}"
                Margin="24,24,0,24"
                Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16">

                <!-- Chat list header -->
                <Label Text="Hộp thư" Style="{StaticResource HeadlineLgMobileLabel}" />

                <!-- Search input -->
                <Border BackgroundColor="{DynamicResource SurfaceContainerLow}"
                        StrokeThickness="0"
                        Padding="14,0"
                        HeightRequest="44">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry Placeholder="Tìm kiếm..."
                           Style="{StaticResource MinimalistEntry}"
                           BackgroundColor="Transparent" />
                </Border>

                <!-- Conversation list -->
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Threads}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatThread">
                                <Border BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter=ActiveThread}"
                                        Stroke="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter=ActiveThread}"
                                        StrokeThickness="1"
                                        Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#14000000"
                                                Offset="0,4"
                                                Radius="12"
                                                Opacity="0.08" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                        <!-- Avatar circle -->
                                        <Border BackgroundColor="{DynamicResource PrimaryContainer}"
                                                StrokeThickness="0"
                                                WidthRequest="44"
                                                HeightRequest="44">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="22" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Initials}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{DynamicResource Primary}"
                                                   FontAttributes="Bold"
                                                   FontFamily="Inter"
                                                   FontSize="14" />
                                        </Border>
                                        <!-- Name + last message -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   TextColor="{DynamicResource OnSurface}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Text="{Binding Preview}"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </VerticalStackLayout>
                                        <!-- Timestamp -->
                                        <Label Grid.Column="2"
                                               Text="{Binding Time}"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               TextColor="{DynamicResource OnSurfaceVariant}"
                                               VerticalOptions="Start" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

            </VerticalStackLayout>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             RIGHT PANEL: Active Conversation (flexible width)
             Header, messages, input area
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Style="{StaticResource GlassCardBorder}"
                Margin="16,24,24,24"
                Padding="24">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">

                <!-- ═══════════════════════════════════════════════════════
                     CONVERSATION HEADER
                     Contact name, role, action buttons
                ═══════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Lê Minh Tuấn"
                               Style="{StaticResource DisplayXlLabel}"
                               LineBreakMode="TailTruncation" />
                        <Label Text="Quản lý kho — Đang hoạt động"
                               Style="{StaticResource BodyMdLabel}"
                               Margin="0,4,0,0"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <!-- Action buttons: call, video, more -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <!-- Call button -->
                        <Border Style="{StaticResource GlassCardBorder}"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>
                            <Label Text="📞"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <!-- Video button -->
                        <Border Style="{StaticResource GlassCardBorder}"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>
                            <Label Text="📹"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <!-- More button -->
                        <Border Style="{StaticResource GlassCardBorder}"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="21" />
                            </Border.StrokeShape>
                            <Label Text="⋯"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource OnSurface}" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Separator -->
                <BoxView Grid.Row="0"
                         HeightRequest="1"
                         Color="{DynamicResource OutlineVariant}"
                         VerticalOptions="End"
                         Margin="0,12,0,0" />

                <!-- ═══════════════════════════════════════════════════════
                     MESSAGE LIST
                     Incoming (white, 2px top-left / 18px others)
                     Outgoing (PrimaryContainer, 18px top / 2px bottom-right)
                     Date dividers with LabelCapsLabel
                ═══════════════════════════════════════════════════════ -->
                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Messages}" Spacing="10" Padding="0,12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessage">
                                <VerticalStackLayout Spacing="10">
                                    <!-- Date divider (shown when IsDateDivider is true) -->
                                    <Border BackgroundColor="#33000000"
                                            StrokeThickness="0"
                                            HorizontalOptions="Center"
                                            Padding="16,6"
                                            IsVisible="{Binding IsDateDivider}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Content}"
                                               Style="{StaticResource LabelCapsLabel}"
                                               TextColor="White"
                                               Padding="0" />
                                    </Border>

                                    <!-- Message bubble -->
                                    <Border HorizontalOptions="{Binding IsOutgoing, Converter={StaticResource BoolToLayoutConverter}}"
                                            BackgroundColor="{Binding IsOutgoing, Converter={StaticResource BoolToColorConverter}, ConverterParameter=MessageBubble}"
                                            StrokeThickness="0"
                                            Padding="14,10"
                                            MaximumWidthRequest="420">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Content}"
                                                   TextColor="{Binding IsOutgoing, Converter={StaticResource BoolToColorConverter}, ConverterParameter=MessageText}"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Time}"
                                                   FontSize="11"
                                                   FontFamily="Inter"
                                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- ═══════════════════════════════════════════════════════
                     MESSAGE INPUT AREA
                     Pill-shaped GlassCardBorder, attachment, emoji, send
                ═══════════════════════════════════════════════════════ -->
                <Border Grid.Row="2"
                        Style="{StaticResource GlassCardBorder}"
                        Padding="8,6"
                        Margin="0,8,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                        <!-- Attachment button -->
                        <Border BackgroundColor="Transparent"
                                StrokeThickness="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Label Text="📎"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <!-- Emoji button -->
                        <Border Grid.Column="1"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Label Text="😊"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <!-- Message entry -->
                        <Entry Grid.Column="2"
                               Placeholder="Nhập tin nhắn..."
                               Style="{StaticResource MinimalistEntry}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                        <!-- Send button -->
                        <Button Grid.Column="3"
                                Text="GỬI"
                                Style="{StaticResource PillPrimaryButton}"
                                Padding="20,10"
                                HeightRequest="38"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentPage>

