<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 PAGE HEADER
                 Title "Bảng điều khiển" in HeadlineLgLabel + welcome message
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout>
                    <Label Text="Bảng điều khiển" Style="{StaticResource HeadlineLgLabel}" />
                    <Label Text="Chào buổi sáng, Quản trị viên. Dưới đây là diễn biến hoạt động bán hàng trong 24h qua."
                           Style="{StaticResource BodyMdLabel}" Margin="0,8,0,0" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <Button Text="7 NGÀY QUA" Style="{StaticResource PillSecondaryButton}" />
                    <Button Text="XUẤT BÁO CÁO" Style="{StaticResource PillPrimaryButton}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 BENTO GRID STATISTICS SECTION
                 GlassCardBorder containers with key metrics
            ═══════════════════════════════════════════════════════════════ -->
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Stats}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,20,20" WidthRequest="220" Padding="22">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                                <!-- Icon container -->
                                <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="42" HeightRequest="42">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" FontSize="16" />
                                </Border>
                                <!-- Subtitle badge -->
                                <Border Grid.Column="1" BackgroundColor="{DynamicResource StatusEmerald}" StrokeThickness="0" HorizontalOptions="End" Padding="10,5" IsVisible="{Binding Subtitle}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9999" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource StatusBadgePill}" TextColor="{DynamicResource Primary}" Padding="0" />
                                </Border>
                                <!-- Metric title -->
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}" Margin="0,18,0,0"
                                       Style="{StaticResource LabelCapsLabel}" />
                                <!-- Large numeric value -->
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Value}" Margin="0,4,0,0"
                                       FontSize="28" FontAttributes="Bold" FontFamily="Inter"
                                       TextColor="{DynamicResource OnSurface}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 MAIN CONTENT AREA
                 Order trends chart + Inventory distribution
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="1.35*,0.65*" ColumnSpacing="24">
                <!-- Order Trends Card -->
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Xu hướng đơn hàng" Style="{StaticResource DataTabularLabel}" FontSize="17" />
                                <Label Text="Thống kê số lượng đơn trong 7 ngày gần nhất"
                                       Style="{StaticResource BodyMdLabel}" FontSize="13" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Start">
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView Color="{DynamicResource Primary}" WidthRequest="9" HeightRequest="9" CornerRadius="4.5" />
                                    <Label Text="Hoàn thành" FontSize="12" FontFamily="Inter" TextColor="{DynamicResource OnSurfaceVariant}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView Color="{DynamicResource PrimaryContainer}" WidthRequest="9" HeightRequest="9" CornerRadius="4.5" />
                                    <Label Text="Đang xử lý" FontSize="12" FontFamily="Inter" TextColor="{DynamicResource OnSurfaceVariant}" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="38" Margin="0,18,0,0">
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                            <BoxView Grid.Row="1" HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                            <BoxView Grid.Row="2" HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                            <BoxView Grid.Row="3" HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                            <Grid Grid.Row="4" ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,12,0,0">
                                <Label Text="THỨ 2" HorizontalTextAlignment="Center" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="1" Text="THỨ 3" HorizontalTextAlignment="Center" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="2" Text="THỨ 4" HorizontalTextAlignment="Center" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="3" Text="THỨ 5" HorizontalTextAlignment="Center" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="4" Text="THỨ 6" HorizontalTextAlignment="Center" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="5" Text="THỨ 7" HorizontalTextAlignment="Center" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="6" Text="CN" HorizontalTextAlignment="Center" Style="{StaticResource LabelCapsLabel}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Inventory Distribution Card -->
                <Border Grid.Column="1" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" Padding="30">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#14000000" Offset="0,8" Radius="24" Opacity="0.12" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Phân bổ tồn kho" TextColor="White" FontSize="17" FontAttributes="Bold" FontFamily="Inter" />
                        <Label Text="Theo danh mục sản phẩm" TextColor="{DynamicResource PrimaryContainer}" FontSize="13" FontFamily="Inter" />
                        <Grid HorizontalOptions="Center" Margin="0,22,0,10">
                            <Border BackgroundColor="White" StrokeThickness="0" WidthRequest="140" HeightRequest="140">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="70" />
                                </Border.StrokeShape>
                            </Border>
                            <Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" WidthRequest="98" HeightRequest="98" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="49" />
                                </Border.StrokeShape>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="75%" TextColor="White" FontSize="24" FontAttributes="Bold" FontFamily="Inter" HorizontalTextAlignment="Center" />
                                    <Label Text="ĐIỆN TỬ" TextColor="{DynamicResource PrimaryContainer}" FontSize="10" FontAttributes="Bold" FontFamily="Inter" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Điện tử" TextColor="White" FontSize="12" FontFamily="Inter" />
                            <Label Grid.Column="1" Text="1,240 SP" TextColor="White" FontSize="12" FontAttributes="Bold" FontFamily="Inter" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Thời trang" TextColor="White" FontSize="12" FontFamily="Inter" />
                            <Label Grid.Column="1" Text="450 SP" TextColor="White" FontSize="12" FontAttributes="Bold" FontFamily="Inter" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Đồ gia dụng" TextColor="White" FontSize="12" FontFamily="Inter" />
                            <Label Grid.Column="1" Text="290 SP" TextColor="White" FontSize="12" FontAttributes="Bold" FontFamily="Inter" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 BOTTOM SECTION
                 Low stock alerts + Recent activity + Quick actions
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
                <!-- Low Stock Alerts Card -->
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Cảnh báo tồn kho thấp" Style="{StaticResource DataTabularLabel}" FontSize="15" />
                            <Label Grid.Column="1" Text="XEM TẤT CẢ" TextColor="{DynamicResource Primary}" FontSize="11" FontAttributes="Bold" FontFamily="Inter" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Alerts}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14">
                                            <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="48" HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Code}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="10" FontAttributes="Bold" FontFamily="Inter" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" />
                                                <Label Text="{Binding Code}" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurfaceVariant}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding StockText}" TextColor="{Binding Accent}" FontSize="12" FontAttributes="Bold" FontFamily="Inter" VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Recent Activity Card -->
                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Hoạt động gần đây" Style="{StaticResource DataTabularLabel}" FontSize="15" />
                            <Label Grid.Column="1" Text="⋮" TextColor="{DynamicResource Primary}" FontSize="16" FontFamily="Inter" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Activities}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="14">
                                        <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="24" HeightRequest="24">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="7" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="10" FontFamily="Inter" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" />
                                            <Label Text="{Binding Time}" FontSize="10" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurfaceVariant}" />
                                        </VerticalStackLayout>
                                        <!-- Status indicator dot -->
                                        <BoxView Grid.Column="2" Color="{Binding Accent}" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Quick Actions Card -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Thao tác nhanh" Style="{StaticResource DataTabularLabel}" FontSize="15" />
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                            <!-- Quick action: Products -->
                            <Border BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="📦" FontSize="24" HorizontalTextAlignment="Center" />
                                    <Label Text="Sản phẩm" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <!-- Quick action: Orders -->
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="🛒" FontSize="24" HorizontalTextAlignment="Center" />
                                    <Label Text="Đơn hàng" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <!-- Quick action: Imports -->
                            <Border Grid.Row="1" BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="🚢" FontSize="24" HorizontalTextAlignment="Center" />
                                    <Label Text="Nhập hàng" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <!-- Quick action: Messages -->
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="💬" FontSize="24" HorizontalTextAlignment="Center" />
                                    <Label Text="Tin nhắn" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
