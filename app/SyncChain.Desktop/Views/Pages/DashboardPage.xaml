<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">
            <Border Style="{StaticResource PageHeaderCard}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Bảng điều khiển" Style="{StaticResource DisplayXlLabel}" />
                    <Label Text="Tổng quan đơn hàng, tồn kho và hoạt động gần đây."
                           Style="{StaticResource BodyMdLabel}"
                           Margin="0,8,0,0" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <Button Text="7 NGÀY QUA" Style="{StaticResource PillSecondaryButton}" />
                    <Button Text="XUẤT BÁO CÁO"
                        Style="{StaticResource PillPrimaryButton}"
                        Clicked="OnExportReportClicked" />
                </HorizontalStackLayout>
            </Grid>
            </Border>

            <FlexLayout Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="Start"
                        BindableLayout.ItemsSource="{Binding Stats}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:StatCard">
                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                Margin="0,0,20,20"
                                WidthRequest="280"
                                HeightRequest="138"
                                Padding="24,20">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid>
                                <Label Text="{Binding IconGlyph}"
                                       FontFamily="MaterialSymbols"
                                       FontSize="96"
                                       TextColor="{Binding Accent}"
                                       Opacity="0.12"
                                       HorizontalOptions="End"
                                       VerticalOptions="End"
                                       Margin="0,0,-12,-16" />
                                <Grid ColumnDefinitions="*,64" RowDefinitions="Auto,Auto,*" ColumnSpacing="16">
                                    <Label Text="{Binding Title}"
                                           TextColor="{DynamicResource OnSurfaceVariant}"
                                           FontFamily="Inter"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1"
                                           Text="{Binding Value}"
                                           Margin="0,8,0,0"
                                           TextColor="{DynamicResource OnSurface}"
                                           FontFamily="Inter"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="2"
                                           Text="{Binding Subtitle}"
                                           Margin="0,6,0,0"
                                           TextColor="{DynamicResource OnSurfaceVariant}"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           Opacity="0.72"
                                           VerticalTextAlignment="End"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="1.35*,0.65*" ColumnSpacing="24">
                <Border Style="{StaticResource GlassCardBorder}" Padding="34">
                    <VerticalStackLayout Spacing="24">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Xu hướng đơn hàng" Style="{StaticResource DataTabularLabel}" FontSize="22" />
                                <Label Text="Thống kê số lượng đơn trong 7 ngày gần nhất"
                                       Style="{StaticResource BodyMdLabel}"
                                       FontSize="15" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="18" VerticalOptions="Start">
                                <HorizontalStackLayout Spacing="7">
                                    <BoxView Color="{DynamicResource Primary}" WidthRequest="10" HeightRequest="10" CornerRadius="5" />
                                    <Label Text="Hoàn thành" FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="7">
                                    <BoxView Color="{DynamicResource PrimaryContainer}" WidthRequest="10" HeightRequest="10" CornerRadius="5" />
                                    <Label Text="Đang xử lý" FontSize="13" TextColor="{DynamicResource OnSurfaceVariant}" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </Grid>

                        <GraphicsView x:Name="OrderTrendChart"
                                      HeightRequest="330"
                                      Margin="0,12,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="{DynamicResource Primary}"
                        StrokeThickness="0"
                        Padding="36">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="18">
                        <Label Text="Phân bổ tồn kho" TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Theo danh mục sản phẩm" TextColor="{DynamicResource PrimaryContainer}" FontSize="15" />
                        <Grid HorizontalOptions="Center"
                              Margin="0,28,0,18"
                              WidthRequest="210"
                              HeightRequest="210">
                            <GraphicsView x:Name="InventoryDonutChart"
                                          WidthRequest="210"
                                          HeightRequest="210" />
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="4">
                                <Label Text="{Binding PrimaryInventoryPercent}"
                                       TextColor="White"
                                       FontSize="32"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding PrimaryInventoryCategory}"
                                       TextColor="{DynamicResource PrimaryContainer}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding InventorySlices}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:InventorySlice">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <BoxView Color="{Binding Color}"
                                                 WidthRequest="10"
                                                 HeightRequest="10"
                                                 CornerRadius="5"
                                                 VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Label}"
                                               TextColor="White"
                                               FontSize="14"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="8">
                                            <Label Text="{Binding PercentText}"
                                                   TextColor="White"
                                                   FontSize="14"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding QuantityText}"
                                                   TextColor="White"
                                                   FontSize="14"
                                                   FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
                <Border Style="{StaticResource GlassCardBorder}" Padding="28">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Cảnh báo tồn kho thấp" Style="{StaticResource DataTabularLabel}" FontSize="18" />
                         
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Alerts}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AlertItem">
                                    <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14">
                                        <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="40" HeightRequest="40">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Code}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource OnSurface}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Code}" FontSize="11" TextColor="{DynamicResource OnSurfaceVariant}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding StockText}"
                                               TextColor="{Binding Accent}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}" Padding="28">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Hoạt động gần đây" Style="{StaticResource DataTabularLabel}" FontSize="18" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Activities}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ActivityItem">
                                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                                        <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="36" HeightRequest="36">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource OnSurface}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Time}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource OnSurfaceVariant}" />
                                        </VerticalStackLayout>
                                        <BoxView Grid.Column="2" Color="{Binding Accent}" WidthRequest="9" HeightRequest="9" CornerRadius="4.5" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Thao tác nhanh" Style="{StaticResource DataTabularLabel}" FontSize="15" />
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                            <Border BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickActionTapped" CommandParameter="//products" />
                                </Border.GestureRecognizers>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="📦" FontSize="24" HorizontalTextAlignment="Center" />
                                    <Label Text="Sản phẩm" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickActionTapped" CommandParameter="//orders" />
                                </Border.GestureRecognizers>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="🛒" FontSize="24" HorizontalTextAlignment="Center" />
                                    <Label Text="Đơn hàng" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickActionTapped" CommandParameter="//imports" />
                                </Border.GestureRecognizers>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="🚢" FontSize="24" HorizontalTextAlignment="Center" />
                                    <Label Text="Nhập hàng" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickActionTapped" CommandParameter="//chat" />
                                </Border.GestureRecognizers>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="💬" FontSize="24" HorizontalTextAlignment="Center" />
                                    <Label Text="Tin nhắn" FontSize="11" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
