<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Đăng ký"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#17213145">
        <Image x:Name="BackgroundPhoto"
               Source="background_signin.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True" />
        <BoxView Color="#33213145" InputTransparent="True" />
        <ScrollView Background="Transparent" BackgroundColor="Transparent">
            <Grid Padding="24" MinimumHeightRequest="900">

                <Border MaximumWidthRequest="520"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="#FAFFFFFF"
                        Stroke="#FFFFFFFF"
                        StrokeThickness="1"
                        Padding="30">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#33213145" Offset="0,18" Radius="48" Opacity="0.45" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="8" Margin="0,0,0,8">
                            <Label Text="Đăng ký tài khoản"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Nhập thông tin để tạo tài khoản khách hàng"
                                   Style="{StaticResource BodyMdLabel}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Border x:Name="GeneralError"
                                IsVisible="False"
                                BackgroundColor="#FFF3F3"
                                Stroke="#FFCDD5"
                                StrokeThickness="1"
                                Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Label x:Name="GeneralErrorLabel" TextColor="#B00020" FontFamily="Inter" FontSize="13" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="HỌ" Style="{StaticResource LabelCapsLabel}" />
                                <Entry x:Name="HoEntry" Style="{StaticResource MinimalistEntry}" Placeholder="Nguyễn" ReturnType="Next" />
                                <Label x:Name="HoError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="TÊN" Style="{StaticResource LabelCapsLabel}" />
                                <Entry x:Name="TenEntry" Style="{StaticResource MinimalistEntry}" Placeholder="Văn A" ReturnType="Next" />
                                <Label x:Name="TenError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="TÊN ĐĂNG NHẬP" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="UsernameEntry" Style="{StaticResource MinimalistEntry}" Placeholder="ten_dang_nhap" ReturnType="Next" />
                            <Label x:Name="UsernameError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="SỐ ĐIỆN THOẠI" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="PhoneEntry" Style="{StaticResource MinimalistEntry}" Placeholder="0901234567" Keyboard="Telephone" ReturnType="Next" />
                            <Label x:Name="PhoneError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="EMAIL" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="EmailEntry" Style="{StaticResource MinimalistEntry}" Placeholder="email@example.com" Keyboard="Email" ReturnType="Next" />
                            <Label x:Name="EmailError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="MẬT KHẨU" Style="{StaticResource LabelCapsLabel}" />
                                <Entry x:Name="PasswordEntry" Style="{StaticResource MinimalistEntry}" Placeholder="••••••••" IsPassword="True" ReturnType="Next" />
                                <Label x:Name="PasswordError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="XÁC NHẬN MẬT KHẨU" Style="{StaticResource LabelCapsLabel}" />
                                <Entry x:Name="ConfirmPasswordEntry" Style="{StaticResource MinimalistEntry}" Placeholder="••••••••" IsPassword="True" ReturnType="Done" />
                                <Label x:Name="ConfirmPasswordError" IsVisible="False" TextColor="#B00020" FontFamily="Inter" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <CheckBox x:Name="AgreeCheckBox" IsChecked="False" Color="{DynamicResource Primary}" />
                            <Label Grid.Column="1"
                                   Text="Tôi đồng ý với Điều khoản dịch vụ và Chính sách bảo mật của hệ thống."
                                   Style="{StaticResource BodyMdLabel}"
                                   VerticalTextAlignment="Center" />
                        </Grid>

                        <Button x:Name="RegisterButton"
                                Text="ĐĂNG KÝ"
                                Style="{StaticResource PillPrimaryButton}"
                                Clicked="OnRegisterClicked" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,4,0,0">
                            <Label Text="Đã có tài khoản?" Style="{StaticResource BodyMdLabel}" VerticalTextAlignment="Center" />
                            <Label Text="Đăng nhập"
                                   TextColor="{DynamicResource Primary}"
                                   FontFamily="Inter"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
