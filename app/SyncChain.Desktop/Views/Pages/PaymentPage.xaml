<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.PaymentPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#EAF6FF"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,40"
                             Spacing="24"
                             MaximumWidthRequest="640"
                             HorizontalOptions="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Button Text="← QUAY LẠI"
                        Style="{StaticResource PillSecondaryButton}"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="Thanh toán đơn hàng" Style="{StaticResource DisplayXlLabel}" />
                    <Label x:Name="OrderInfoLabel" Style="{StaticResource BodyMdLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#D8E1EB"
                    StrokeThickness="1"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Tổng tiền cần thanh toán"
                           Style="{StaticResource DataTabularLabel}"
                           FontSize="16"
                           VerticalTextAlignment="Center" />
                    <Label x:Name="TotalLabel"
                           Grid.Column="1"
                           Style="{StaticResource DataTabularLabel}"
                           FontSize="24"
                           TextColor="#F0442E"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#D8E1EB"
                    StrokeThickness="1"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Chọn phương thức thanh toán"
                           Style="{StaticResource HeadlineLgMobileLabel}"
                           FontSize="18" />
                    <BoxView HeightRequest="1" Color="#D8E1EB" />

                    <Border x:Name="CodBorder" BackgroundColor="#F7FBFF" Stroke="#D8E1EB" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#FFE6D7" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="COD" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" TextColor="#F0442E" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Thanh toán khi nhận hàng (COD)" Style="{StaticResource DataTabularLabel}" />
                                <Label Text="Trả tiền mặt khi nhận đơn hàng" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                            </VerticalStackLayout>
                            <RadioButton x:Name="CodRadio"
                                         Grid.Column="2"
                                         GroupName="PayMethod"
                                         Value="cod"
                                         VerticalOptions="Center"
                                         IsChecked="True"
                                         CheckedChanged="OnMethodChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="VnpayBorder" BackgroundColor="#F7FBFF" Stroke="#D8E1EB" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#E4F0FF" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="VN" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="#213145" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="VNPay" Style="{StaticResource DataTabularLabel}" />
                                <Label Text="Thanh toán qua cổng VNPay (ATM, QR, ví)" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                            </VerticalStackLayout>
                            <RadioButton x:Name="VnpayRadio"
                                         Grid.Column="2"
                                         GroupName="PayMethod"
                                         Value="vnpay"
                                         VerticalOptions="Center"
                                         CheckedChanged="OnMethodChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="MomoBorder" BackgroundColor="#F7FBFF" Stroke="#D8E1EB" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#FFE4F1" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="MO" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="#B0005A" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="MoMo" Style="{StaticResource DataTabularLabel}" />
                                <Label Text="Thanh toán qua ví điện tử MoMo" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                            </VerticalStackLayout>
                            <RadioButton x:Name="MomoRadio"
                                         Grid.Column="2"
                                         GroupName="PayMethod"
                                         Value="momo"
                                         VerticalOptions="Center"
                                         CheckedChanged="OnMethodChanged" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="WaitingNotice"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#D8E1EB"
                    StrokeThickness="1"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="#F0442E" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Đang chờ xác nhận thanh toán từ cổng..."
                           Style="{StaticResource BodyMdLabel}"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <Button x:Name="ConfirmButton"
                    Text="XÁC NHẬN THANH TOÁN"
                    Style="{StaticResource PillPrimaryButton}"
                    BackgroundColor="#F0442E"
                    BorderColor="#F0442E"
                    TextColor="White"
                    Padding="0,16"
                    FontSize="16"
                    Clicked="OnConfirmClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
