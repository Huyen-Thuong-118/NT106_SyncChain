<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.PaymentPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,40" Spacing="24" MaximumWidthRequest="560"
                             HorizontalOptions="Center">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Button Text="← Quay lại" Style="{StaticResource PillSecondaryButton}"
                        Clicked="OnBackClicked" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Thanh toán đơn hàng" Style="{StaticResource DisplayXlLabel}" />
                    <Label x:Name="OrderInfoLabel" Style="{StaticResource BodyMdLabel}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Tổng tiền -->
            <Border Style="{StaticResource GlassCardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Tổng tiền cần thanh toán" Style="{StaticResource DataTabularLabel}" FontSize="16" VerticalTextAlignment="Center" />
                    <Label x:Name="TotalLabel" Grid.Column="1" Style="{StaticResource DataTabularLabel}" FontSize="22"
                           TextColor="{DynamicResource Primary}" VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <!-- Chọn phương thức -->
            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Chọn phương thức thanh toán" Style="{StaticResource HeadlineLgMobileLabel}" FontSize="18" />
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <!-- COD -->
                    <Border x:Name="CodBorder" Style="{StaticResource GlassCardBorder}" Padding="16">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource StatusAmber}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="💵" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Thanh toán khi nhận hàng (COD)" Style="{StaticResource DataTabularLabel}" />
                                <Label Text="Trả tiền mặt khi nhận đơn hàng" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                            </VerticalStackLayout>
                            <RadioButton x:Name="CodRadio" Grid.Column="2" GroupName="PayMethod" Value="cod"
                                         VerticalOptions="Center" IsChecked="True" CheckedChanged="OnMethodChanged" />
                        </Grid>
                    </Border>

                    <!-- VNPay -->
                    <Border x:Name="VnpayBorder" Style="{StaticResource GlassCardBorder}" Padding="16">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="🏦" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="VNPay" Style="{StaticResource DataTabularLabel}" />
                                <Label Text="Thanh toán qua cổng VNPay (ATM, QR, ví)" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                            </VerticalStackLayout>
                            <RadioButton x:Name="VnpayRadio" Grid.Column="2" GroupName="PayMethod" Value="vnpay"
                                         VerticalOptions="Center" CheckedChanged="OnMethodChanged" />
                        </Grid>
                    </Border>

                    <!-- MoMo -->
                    <Border x:Name="MomoBorder" Style="{StaticResource GlassCardBorder}" Padding="16">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource StatusEmerald}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="📱" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="MoMo" Style="{StaticResource DataTabularLabel}" />
                                <Label Text="Thanh toán qua ví điện tử MoMo" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                            </VerticalStackLayout>
                            <RadioButton x:Name="MomoRadio" Grid.Column="2" GroupName="PayMethod" Value="momo"
                                         VerticalOptions="Center" CheckedChanged="OnMethodChanged" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Waiting notice cho VNPay/MoMo -->
            <Border x:Name="WaitingNotice" Style="{StaticResource GlassCardBorder}"
                    IsVisible="False" BackgroundColor="{DynamicResource PrimaryContainer}">
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="{DynamicResource Primary}" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Đang chờ xác nhận thanh toán từ cổng..." Style="{StaticResource BodyMdLabel}"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Nút xác nhận -->
            <Button x:Name="ConfirmButton" Text="XÁC NHẬN THANH TOÁN"
                    Style="{StaticResource PillPrimaryButton}"
                    Padding="0,16" FontSize="16"
                    Clicked="OnConfirmClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
