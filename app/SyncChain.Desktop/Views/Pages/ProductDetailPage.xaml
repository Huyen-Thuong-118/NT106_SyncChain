<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.ProductDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="48,30" Spacing="24">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button Text="← QUAY LẠI" Style="{StaticResource PillSecondaryButton}" Clicked="OnBackClicked" />
                <Label Grid.Column="1" />
                <Button Grid.Column="2" Text="CHỈNH SỬA" Style="{StaticResource PillPrimaryButton}"
                        IsVisible="{Binding CanManageProducts}"
                        Clicked="OnEditClicked" />
                <Button Grid.Column="3" Text="XÓA" Style="{StaticResource PillSecondaryButton}"
                        IsVisible="{Binding CanManageProducts}"
                        Clicked="OnDeleteClicked" />
            </Grid>

            <Grid ColumnDefinitions="1.15*,1*" ColumnSpacing="24">
                <Border Style="{StaticResource GlassCardBorder}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="HÌNH ẢNH SẢN PHẨM" Style="{StaticResource LabelCapsLabel}" />

                        <Border HeightRequest="430"
                                BackgroundColor="White"
                                Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Grid Padding="10">
                                <Label Text="{Binding ProductInitials}"
                                       FontSize="92" FontAttributes="Bold" Opacity="0.14"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{DynamicResource Primary}" />
                                <Image Source="{Binding SelectedImageUrl}"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                            </Grid>
                        </Border>

                        <CollectionView x:Name="ProductImageGallery"
                                        ItemsSource="{Binding ProductImages}"
                                        ItemsLayout="HorizontalList"
                                        SelectionMode="Single"
                                        SelectionChanged="OnImageSelected"
                                        HeightRequest="105"
                                        HorizontalScrollBarVisibility="Always">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductImageItem">
                                    <Border WidthRequest="96" HeightRequest="96"
                                            Margin="0,0,10,0"
                                            BackgroundColor="White"
                                            Stroke="{DynamicResource OutlineVariant}"
                                            StrokeThickness="1">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="Stroke" Value="#E65100" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid Padding="4">
                                            <Image Source="{Binding Url}"
                                                   Aspect="AspectFit"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{Binding ImageCountText}" Style="{StaticResource BodyMdLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding ProductCode}" Style="{StaticResource LabelCapsLabel}" />
                            <Border Grid.Column="1" BackgroundColor="{Binding ProductStatusColor}"
                                    StrokeThickness="0" Padding="11,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding ProductStatus}" FontSize="11"
                                       FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding ProductName}" Style="{StaticResource DisplayXlLabel}"
                               LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="16" ColumnSpacing="18">
                            <VerticalStackLayout>
                                <Label Text="GIÁ BÁN" Style="{StaticResource LabelCapsLabel}" />
                                <Label Text="{Binding Price}" FontSize="24" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="GIÁ NHẬP" Style="{StaticResource LabelCapsLabel}" />
                                <Label Text="{Binding ImportPrice}" FontSize="24" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1">
                                <Label Text="LOẠI SẢN PHẨM" Style="{StaticResource LabelCapsLabel}" />
                                <Label Text="{Binding Category}" Style="{StaticResource DataTabularLabel}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="TỒN KHO" Style="{StaticResource LabelCapsLabel}" />
                                <Label Text="{Binding Stock}" FontSize="24" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2">
                                <Label Text="ĐÃ BÁN" Style="{StaticResource LabelCapsLabel}" />
                                <Label Text="{Binding SoldCount}" FontSize="24" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                                <Label Text="HIỆU SUẤT THÁNG" Style="{StaticResource LabelCapsLabel}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding PerformanceIcon}" FontSize="22"
                                           FontAttributes="Bold" TextColor="{Binding PerformanceColor}" />
                                    <Label Text="{Binding PerformanceText}" FontSize="20"
                                           FontAttributes="Bold" TextColor="{Binding PerformanceColor}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="10" Margin="0,8,0,0"
                                               IsVisible="{Binding CanManageProducts}">
                            <Button Text="NHẬP THÊM HÀNG" Style="{StaticResource PillPrimaryButton}"
                                    Clicked="OnImportStockClicked" />
                            <Button Text="{Binding StatusActionText}" Style="{StaticResource PillSecondaryButton}"
                                    Clicked="OnToggleStatusClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Thông tin sản phẩm" Style="{StaticResource HeadlineLgMobileLabel}" />
                    <Grid ColumnDefinitions="180,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="24"
                          RowSpacing="18">
                        <Label Grid.Row="0" Text="Tên sản phẩm"
                               Style="{StaticResource BodyMdLabel}" VerticalTextAlignment="Start" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}"
                               Style="{StaticResource DataTabularLabel}" LineBreakMode="WordWrap" />

                        <Label Grid.Row="1" Text="Mã sản phẩm"
                               Style="{StaticResource BodyMdLabel}" VerticalTextAlignment="Start" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProductCode}"
                               Style="{StaticResource DataTabularLabel}" LineBreakMode="WordWrap" />

                        <Label Grid.Row="2" Text="Danh mục"
                               Style="{StaticResource BodyMdLabel}" VerticalTextAlignment="Start" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Category}"
                               Style="{StaticResource DataTabularLabel}" LineBreakMode="WordWrap" />

                        <Label Grid.Row="3" Text="Mô tả"
                               Style="{StaticResource BodyMdLabel}" VerticalTextAlignment="Start" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding ProductDescription}"
                               Style="{StaticResource BodyMdLabel}" LineBreakMode="WordWrap" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Đánh giá" Style="{StaticResource HeadlineLgMobileLabel}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding RatingText}" FontSize="34" FontAttributes="Bold" />
                            <Label Text="{Binding RatingStars}" FontSize="22" TextColor="#F5A623" />
                            <Label Text="{Binding ReviewCountText}" Style="{StaticResource BodyMdLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                StrokeThickness="0" Padding="20">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="{Binding ReviewEmptyText}" Style="{StaticResource BodyMdLabel}"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
