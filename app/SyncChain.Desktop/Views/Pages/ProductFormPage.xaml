<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.ProductFormPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24" MaximumWidthRequest="900">
            <Grid ColumnDefinitions="Auto,*">
                <Button Text="← QUAY LẠI" Style="{StaticResource PillSecondaryButton}" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="{Binding PageTitle}" Style="{StaticResource DisplayXlLabel}"
                       HorizontalTextAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="THÔNG TIN SẢN PHẨM" Style="{StaticResource LabelCapsLabel}" />
                    <Entry x:Name="NameEntry" Placeholder="Tên sản phẩm" />
                    <Editor x:Name="DescriptionEditor" Placeholder="Mô tả" AutoSize="TextChanges" HeightRequest="100" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="GIÁ NHẬP" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="CostPriceEntry" Keyboard="Numeric" Placeholder="0" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="GIÁ BÁN" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="SalePriceEntry" Keyboard="Numeric" Placeholder="0" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="1.25*,*" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="DANH MỤC" Style="{StaticResource LabelCapsLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="54">
                                <Picker x:Name="CategoryPicker" Title="Chọn danh mục"
                                        MinimumWidthRequest="340"
                                        HeightRequest="54"
                                        HorizontalOptions="Fill"
                                        ItemsSource="{Binding Categories}"
                                        ItemDisplayBinding="{Binding TenDanhMuc}" />
                                <Button Grid.Column="1" Text="+ THÊM"
                                        Style="{StaticResource PillSecondaryButton}"
                                        Clicked="OnAddCategoryClicked" />
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="TỒN KHO BAN ĐẦU" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="StockEntry" Keyboard="Numeric" Placeholder="0" />
                            <Label Text="{Binding StockHint}" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="HÌNH ẢNH SẢN PHẨM" Style="{StaticResource LabelCapsLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Editor x:Name="ImageUrlEntry"
                                    Placeholder="Dán một hoặc nhiều đường dẫn ảnh, cách nhau bằng dấu phẩy hoặc xuống dòng"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="72" />
                            <Button Grid.Column="1" Text="CHỌN NHIỀU ẢNH"
                                    Style="{StaticResource PillSecondaryButton}"
                                    Clicked="OnPickImageClicked" />
                        </Grid>
                        <Label Text="{Binding SelectedImagesText}"
                               Style="{StaticResource BodyMdLabel}" FontSize="12" />
                        <CollectionView ItemsSource="{Binding ImagePreviews}"
                                        ItemsLayout="HorizontalList"
                                        HeightRequest="120"
                                        HorizontalScrollBarVisibility="Always">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="110" HeightRequest="110"
                                            Margin="0,0,10,0"
                                            BackgroundColor="White"
                                            Stroke="{DynamicResource OutlineVariant}"
                                            StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding Url}" Aspect="AspectFit" Margin="4" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding StatusMessage}" Style="{StaticResource BodyMdLabel}"
                               VerticalTextAlignment="Center" />
                        <Button Grid.Column="1" Text="{Binding SaveButtonText}"
                                Style="{StaticResource PillPrimaryButton}"
                                Clicked="OnSaveClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
