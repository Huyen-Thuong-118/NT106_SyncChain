<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                <Label Text="Quản lý Đơn hàng"
                       Style="{StaticResource DisplayXlLabel}"
                       VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="12">
                    <Button Text="+ TẠO ĐƠN HÀNG"
                            Style="{StaticResource PillSecondaryButton}"
                            Clicked="OnCreateOrderClicked" />
                    <Button Text="XUẤT BÁO CÁO"
                            Style="{StaticResource PillPrimaryButton}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Giữ bố cục hai thẻ giống giao diện cũ -->
            <Grid ColumnDefinitions="1.4*,*" ColumnSpacing="24">
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Tốc độ vận hành"
                                   Style="{StaticResource LabelCapsLabel}"
                                   VerticalTextAlignment="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{DynamicResource StatusEmerald}"
                                    StrokeThickness="0"
                                    Padding="12,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="⚡ DỮ LIỆU THỰC"
                                       Style="{StaticResource StatusBadgePill}"
                                       TextColor="{DynamicResource Primary}"
                                       Padding="0" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding PeriodOrderCount}"
                               FontSize="42"
                               FontAttributes="Bold"
                               FontFamily="SourceSerif4"
                               TextColor="{DynamicResource OnSurface}"
                               LineBreakMode="NoWrap" />
                        <Label Text="{Binding PeriodDescription}"
                               Style="{StaticResource BodyMdLabel}" />

                        <!-- Grid.Column rõ ràng để không còn đè chữ -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="32"
                              Margin="0,8,0,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="ĐƠN HÀNG / NGÀY"
                                       Style="{StaticResource LabelCapsLabel}" />
                                <Label Text="{Binding OrdersPerDay}"
                                       Style="{StaticResource DataTabularLabel}"
                                       FontSize="17"
                                       LineBreakMode="NoWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="TỶ LỆ HOÀN THÀNH"
                                       Style="{StaticResource LabelCapsLabel}" />
                                <Label Text="{Binding CompletionRate}"
                                       Style="{StaticResource DataTabularLabel}"
                                       FontSize="17"
                                       LineBreakMode="NoWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Tổng quan nhanh"
                                   Style="{StaticResource LabelCapsLabel}"
                                   VerticalTextAlignment="Center" />
                            <Picker Grid.Column="1"
                                    x:Name="PeriodPicker"
                                    WidthRequest="120"
                                    SelectedIndex="1"
                                    SelectedIndexChanged="OnPeriodChanged">
                                <Picker.Items>
                                    <x:String>Ngày</x:String>
                                    <x:String>Tháng</x:String>
                                    <x:String>Năm</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>

                        <Grid RowDefinitions="Auto,1,Auto,1,Auto,1,Auto"
                              RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Tổng đơn" Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Column="1" Text="{Binding PeriodOrderCount}"
                                       Style="{StaticResource DataTabularLabel}" FontSize="24" />
                            </Grid>
                            <BoxView Grid.Row="1" Color="{DynamicResource OutlineVariant}" />

                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <Label Text="Đơn hoàn thành" Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Column="1" Text="{Binding CompletedOrders}"
                                       Style="{StaticResource DataTabularLabel}" FontSize="24" />
                            </Grid>
                            <BoxView Grid.Row="3" Color="{DynamicResource OutlineVariant}" />

                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                                <Label Text="Chờ duyệt" Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Column="1" Text="{Binding PendingOrders}"
                                       Style="{StaticResource DataTabularLabel}" FontSize="24" />
                            </Grid>
                            <BoxView Grid.Row="5" Color="{DynamicResource OutlineVariant}" />

                            <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
                                <Label Text="Tổng doanh thu" Style="{StaticResource BodyMdLabel}" />
                                <Label Grid.Column="1" Text="{Binding TotalRevenue}"
                                       Style="{StaticResource DataTabularLabel}" FontSize="20" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Bảng giữ phong cách giao diện cũ, chức năng lọc/phân trang mới -->
            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Danh sách đơn hàng"
                               Style="{StaticResource DataTabularLabel}"
                               FontSize="17"
                               VerticalTextAlignment="Center" />
                        <Picker Grid.Column="1"
                                x:Name="StatusPicker"
                                WidthRequest="180"
                                SelectedIndex="0"
                                SelectedIndexChanged="OnStatusChanged">
                             <Picker.Items>
                                <x:String>Tất cả trạng thái</x:String>
                                <x:String>Chờ duyệt</x:String>
                                <x:String>Đang xử lý</x:String>
                                <x:String>Vận chuyển</x:String>
                                <x:String>Hoàn thành</x:String>
                                <x:String>Đã hủy</x:String>
                            </Picker.Items>
                        </Picker>
                        
                    </Grid>

                    <Grid ColumnDefinitions="1.2*,1.5*,1.8*,1.2*,1.2*,120"
                          ColumnSpacing="12"
                          Padding="8,0">
                        <Label Text="MÃ ĐƠN" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="1" Text="KHÁCH HÀNG" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="2" Text="SẢN PHẨM" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="3" Text="TRẠNG THÁI" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="4" Text="GIÁ TRỊ (VNĐ)" Style="{StaticResource LabelCapsLabel}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:OrderItem">
                                <Border BackgroundColor="Transparent"
                                        StrokeThickness="0"
                                        Padding="8,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="1.2*,1.5*,1.8*,1.2*,1.2*,120"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="{Binding Code}"
                                                   Style="{StaticResource DataTabularLabel}"
                                                   TextColor="{DynamicResource Primary}" />
                                            <Label Text="{Binding CreatedAt}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Customer}"
                                                   Style="{StaticResource DataTabularLabel}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Email}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding ProductSummary}"
                                               Style="{StaticResource BodyMdLabel}"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="TailTruncation" />
                                        <Border Grid.Column="3"
                                                BackgroundColor="{Binding StatusColor}"
                                                StrokeThickness="0"
                                                Padding="12,5"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Status}"
                                                   Style="{StaticResource StatusBadgePill}"
                                                   Padding="0" />
                                        </Border>
                                        <Label Grid.Column="4"
                                               Text="{Binding Total}"
                                               Style="{StaticResource DataTabularLabel}"
                                               VerticalTextAlignment="Center" />
                                        <Button Grid.Column="5"
                                                WidthRequest="120"
                                                Text="CHI TIẾT"
                                                Style="{StaticResource PillSecondaryButton}"
                                                Padding="14,8"
                                                CommandParameter="{Binding Id}"
                                                Clicked="OnOpenDetailClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="{Binding PaginationText}"
                               Style="{StaticResource BodyMdLabel}"
                               VerticalTextAlignment="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                            <Button Text="TRƯỚC"
                                    Style="{StaticResource PillSecondaryButton}"
                                    IsEnabled="{Binding CanGoPrevious}"
                                    Clicked="OnPreviousPageClicked" />
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding PageButtons}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:PageButtonItem">
                                        <Button Text="{Binding Text}"
                                                WidthRequest="44"
                                                HeightRequest="42"
                                                Padding="4"
                                                BackgroundColor="{Binding BackgroundColor}"
                                                TextColor="{Binding TextColor}"
                                                BorderColor="{DynamicResource Primary}"
                                                BorderWidth="1"
                                                CornerRadius="10"
                                                CommandParameter="{Binding PageNumber}"
                                                Clicked="OnPageClicked" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <Button Text="TIẾP"
                                    Style="{StaticResource PillSecondaryButton}"
                                    IsEnabled="{Binding CanGoNext}"
                                    Clicked="OnNextPageClicked" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
