<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView Background="{StaticResource AppPageBackgroundBrush}">
        <VerticalStackLayout Padding="30" Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="QUẢN LÝ ĐƠN HÀNG" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="Theo dõi và xử lý các giao dịch bán lẻ trong hệ thống." Style="{StaticResource CaptionLabel}" FontSize="14" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ Tạo đơn hàng mới" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnCreateOrderClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <Border Style="{StaticResource CardBorderStyle}"><VerticalStackLayout><Label Text="TỔNG ĐƠN HÀNG" Style="{StaticResource CaptionLabel}" /><Label Text="1,284" FontSize="28" FontAttributes="Bold" /></VerticalStackLayout></Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout><Label Text="ĐƠN CHỜ" Style="{StaticResource CaptionLabel}" /><Label Text="42" FontSize="28" FontAttributes="Bold" /></VerticalStackLayout></Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout><Label Text="HOÀN TẤT" Style="{StaticResource CaptionLabel}" /><Label Text="856" FontSize="28" FontAttributes="Bold" /></VerticalStackLayout></Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout><Label Text="HỦY ĐƠN" Style="{StaticResource CaptionLabel}" /><Label Text="18" FontSize="28" FontAttributes="Bold" /></VerticalStackLayout></Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Tất cả" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Text="Đã xử lý" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Text="Đang xử lý" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Text="Hoàn tất" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Text="Hủy" Style="{StaticResource SecondaryButtonStyle}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <Button Text="□ 30 ngày qua ▾" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Text="≡" Style="{StaticResource SecondaryButtonStyle}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="18">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="110,2.2*,1.1*,1*,Auto,Auto" ColumnSpacing="16">
                                        <Label Text="{Binding Code}" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" VerticalTextAlignment="Center" />
                                        <Grid Grid.Column="1" ColumnDefinitions="54,*" ColumnSpacing="12">
                                            <Border BackgroundColor="#E8F1FF" StrokeThickness="0" WidthRequest="46" HeightRequest="46">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="15" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Customer}" FontAttributes="Bold" />
                                                <Label Text="{Binding Email}" Style="{StaticResource CaptionLabel}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Grid.Column="2" Text="{Binding CreatedAt}" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="{Binding Total}" VerticalTextAlignment="Center" FontAttributes="Bold" />
                                        <Border Grid.Column="4" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" Padding="10,4" HorizontalOptions="End" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="999" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Status}" TextColor="White" />
                                        </Border>
                                        <Button Grid.Column="5" Text="Xem chi tiết" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnOpenDetailClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Hiển thị 1 - 5 trong số 1,284 đơn hàng" Style="{StaticResource CaptionLabel}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="‹" VerticalTextAlignment="Center" />
                            <Button Text="1" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" />
                            <Button Text="2" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" />
                            <Button Text="3" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" />
                            <Label Text="..." VerticalTextAlignment="Center" />
                            <Button Text="267" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" />
                            <Label Text="›" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="1.3*,0.7*" ColumnSpacing="18">
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Báo cáo hiệu suất đơn hàng quý III" Style="{StaticResource SectionTitleLabel}" />
                        <Label Text="Dữ liệu đơn hàng của bạn đã tăng 24% so với cùng kỳ năm ngoái. Kiểm tra phân tích chi tiết để có chiến lược kinh doanh tốt hơn." FontSize="14" TextColor="{StaticResource TextSecondaryColor}" />
                        <Button Text="Xem báo cáo chi tiết" Style="{StaticResource PrimaryButtonStyle}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource SidebarColor}" StrokeThickness="0" Padding="24">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="MẸO NHỎ" TextColor="#B7CDF8" FontSize="11" FontAttributes="Bold" />
                        <Label Text="Tối ưu hóa kho hàng" TextColor="White" FontSize="24" FontAttributes="Bold" />
                        <Label Text="Các đơn hàng “Đang xử lý” thường mất trung bình 4 giờ để hoàn thiện. Bạn có thể giảm thời gian này bằng cách sử dụng nhân viên tự động." TextColor="#D7E6FF" FontSize="13" />
                        <Label Text="Tìm hiểu thêm →" TextColor="White" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
