<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.UserAccessPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <Grid Padding="30" Background="{StaticResource AppPageBackgroundBrush}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="Danh sách Người dùng" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="Hệ thống › Quản lý người dùng" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Xem lịch sử đăng nhập" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="2" Text="Đăng xuất" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnLogoutClicked" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <Border Style="{StaticResource CardBorderStyle}"><VerticalStackLayout><Label Text="Người dùng hoạt động" Style="{StaticResource CaptionLabel}" /><Label Text="32" FontSize="28" FontAttributes="Bold" /></VerticalStackLayout></Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout><Label Text="Admin" Style="{StaticResource CaptionLabel}" /><Label Text="03" FontSize="28" FontAttributes="Bold" /></VerticalStackLayout></Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout><Label Text="Manager" Style="{StaticResource CaptionLabel}" /><Label Text="09" FontSize="28" FontAttributes="Bold" /></VerticalStackLayout></Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout><Label Text="Passkey required" Style="{StaticResource CaptionLabel}" /><Label Text="Yes" FontSize="28" FontAttributes="Bold" /></VerticalStackLayout></Border>
            </Grid>

            <Grid Grid.Row="2" BackgroundColor="#64748B33">
                <Border Style="{StaticResource CardBorderStyle}" WidthRequest="760" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Thêm người dùng mới" Style="{StaticResource SectionTitleLabel}" />
                                <Label Text="Cung cấp thông tin tài khoản cho nhân viên mới." Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="×" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Label Text="HỌ VÀ TÊN" Style="{StaticResource CaptionLabel}" />
                        <Entry Placeholder="Nhập tên nhân viên..." />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="EMAIL CÔNG VIỆC" Style="{StaticResource CaptionLabel}" />
                                <Entry Placeholder="example@syncchain.com" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="MẬT KHẨU TẠM THỜI" Style="{StaticResource CaptionLabel}" />
                                <Entry Placeholder="12345678" IsPassword="True" Text="12345678" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="VAI TRÒ HỆ THỐNG" Style="{StaticResource CaptionLabel}" />
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Roles}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=SelectedRole}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="14" WidthRequest="220">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" Style="{StaticResource CaptionLabel}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalOptions="End">
                            <Button Text="Hủy bỏ" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="1" Text="Tạo tài khoản" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
