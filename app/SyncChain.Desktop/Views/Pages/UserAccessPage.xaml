<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.UserAccessPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 PAGE HEADER
                 Title + breadcrumb + action buttons
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Người dùng &amp; Phân quyền" Style="{StaticResource DisplayXlLabel}" />
                    <Label Text="Hệ thống › Quản lý người dùng" Style="{StaticResource BodyMdLabel}" Margin="0,8,0,0" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="ĐĂNG XUẤT" Style="{StaticResource PillPrimaryButton}" Clicked="OnLogoutClicked" VerticalOptions="Center" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 STATISTICS CARDS
                 4-column grid with GlassCardBorder containers
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="NGƯỜI DÙNG HOẠT ĐỘNG" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="{Binding TotalUsers}" FontSize="28" FontAttributes="Bold" FontFamily="Inter"
                               TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="QUẢN TRỊ VIÊN" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="{Binding AdminCount}" FontSize="28" FontAttributes="Bold" FontFamily="Inter"
                               TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="QUẢN LÝ" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="{Binding ManagerCount}" FontSize="28" FontAttributes="Bold" FontFamily="Inter"
                               TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="NHÂN VIÊN" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="{Binding StaffCount}" FontSize="28" FontAttributes="Bold" FontFamily="Inter"
                               TextColor="{DynamicResource OnSurface}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 ADD NEW USER FORM
                 GlassCardBorder container with form fields
            ═══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <!-- Form header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Thêm người dùng mới" Style="{StaticResource DataTabularLabel}" FontSize="17" />
                            <Label Text="Cung cấp thông tin tài khoản cho nhân viên mới."
                                   Style="{StaticResource BodyMdLabel}" FontSize="13" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="LÀM MỚI" Style="{StaticResource PillSecondaryButton}"
                                Padding="12,8" Clicked="OnResetFormClicked" />
                    </Grid>

                    <!-- Full name field -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="HỌ VÀ TÊN" Style="{StaticResource LabelCapsLabel}" />
                        <Entry x:Name="NewUsernameEntry" Placeholder="Nhập tên nhân viên..." />
                    </VerticalStackLayout>

                    <!-- Email and password row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="EMAIL CÔNG VIỆC" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="NewEmailEntry" Placeholder="example@syncchain.com" Keyboard="Email" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="MẬT KHẨU TẠM THỜI" Style="{StaticResource LabelCapsLabel}" />
                            <Entry x:Name="NewPasswordEntry" Placeholder="Tối thiểu 6 ký tự" IsPassword="True" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Role selection -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="VAI TRÒ HỆ THỐNG" Style="{StaticResource LabelCapsLabel}" />
                        <Picker x:Name="NewRolePicker" SelectedIndex="2" Title="Chọn vai trò">
                            <Picker.Items>
                                <x:String>Admin</x:String>
                                <x:String>Manager</x:String>
                                <x:String>Staff</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <!-- Action buttons -->
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalOptions="End">
                        <Button Text="HỦY BỎ" Style="{StaticResource PillSecondaryButton}"
                                Clicked="OnResetFormClicked" />
                        <Button Grid.Column="1" Text="TẠO TÀI KHOẢN" Style="{StaticResource PillPrimaryButton}"
                                Clicked="OnCreateUserClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Danh sách tài khoản nội bộ"
                                   Style="{StaticResource DataTabularLabel}" FontSize="17" />
                            <Label Text="Quản lý tài khoản admin, manager và staff."
                                   Style="{StaticResource BodyMdLabel}" FontSize="13" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="TẢI LẠI"
                                Style="{StaticResource PillSecondaryButton}"
                                Clicked="OnReloadClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="1.2*,1.6*,0.8*,0.8*,72"
                          ColumnSpacing="12" Padding="10,0">
                        <Label Text="TÊN ĐĂNG NHẬP" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="1" Text="EMAIL" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="2" Text="VAI TRÒ" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="3" Text="TRẠNG THÁI" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="4"
                               Text="THAO TÁC"
                               Style="{StaticResource LabelCapsLabel}"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Users}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:UserApi">
                                <Border BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                        StrokeThickness="0" Padding="10,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="1.2*,1.6*,0.8*,0.8*,72"
                                          ColumnSpacing="12">
                                        <Label Text="{Binding TenDangNhap}"
                                               Style="{StaticResource DataTabularLabel}"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding Email}"
                                               Style="{StaticResource BodyMdLabel}"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2" Text="{Binding Role}"
                                               Style="{StaticResource DataTabularLabel}"
                                               VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="{Binding StatusText}"
                                               TextColor="{Binding StatusColor}"
                                               FontAttributes="Bold" FontSize="12"
                                               VerticalTextAlignment="Center" />
                                        <Button Grid.Column="4"
                                                Text="⋮"
                                                Style="{StaticResource PillSecondaryButton}"
                                                WidthRequest="48"
                                                HeightRequest="44"
                                                Padding="0"
                                                FontSize="24"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                CommandParameter="{Binding MaNguoiDung}"
                                                Clicked="OnUserActionsClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

        <Grid IsVisible="{Binding IsLoginHistoryOpen}"
              BackgroundColor="#99000000"
              Padding="90,60"
              ZIndex="10">
            <Border BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeThickness="1"
                    Padding="24"
                    MaximumWidthRequest="1000"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Lịch sử đăng nhập"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   FontSize="25" />
                            <Label Text="{Binding LoginHistoryUserText}"
                                   Style="{StaticResource BodyMdLabel}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×"
                                Style="{StaticResource PillSecondaryButton}"
                                Padding="14,8" FontSize="20"
                                Clicked="OnCloseLoginHistoryClicked" />
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="1.4*,1*,1.4*"
                          ColumnSpacing="16" Padding="10,0">
                        <Label Text="THIẾT BỊ" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="1" Text="THỜI GIAN" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="2" Text="ĐỊA ĐIỂM / IP" Style="{StaticResource LabelCapsLabel}" />
                    </Grid>

                    <CollectionView Grid.Row="2"
                                    ItemsSource="{Binding LoginHistory}"
                                    VerticalScrollBarVisibility="Always">
                        <CollectionView.EmptyView>
                            <Label Text="Tài khoản chưa có lịch sử đăng nhập."
                                   Style="{StaticResource BodyMdLabel}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,32" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:LoginHistoryApi">
                                <Border BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                        StrokeThickness="0"
                                        Padding="12" Margin="0,0,0,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="1.4*,1*,1.4*"
                                          ColumnSpacing="16">
                                        <Label Text="{Binding Device}"
                                               Style="{StaticResource BodyMdLabel}"
                                               LineBreakMode="WordWrap" />
                                        <Label Grid.Column="1" Text="{Binding TimeText}"
                                               Style="{StaticResource DataTabularLabel}" />
                                        <Label Grid.Column="2" Text="{Binding LocationText}"
                                               Style="{StaticResource BodyMdLabel}"
                                               LineBreakMode="WordWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
