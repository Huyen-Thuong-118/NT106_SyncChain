<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.CustomerHomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SyncChain.Desktop.Views.Pages"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             BackgroundColor="#EAF6FF"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="48,30" Spacing="24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding UserName, StringFormat='Xin chào, {0}'}"
                           Style="{StaticResource DisplayXlLabel}" />
                    <Label Text="{Binding UserEmail}"
                           Style="{StaticResource BodyMdLabel}" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Button Text="MUA SẮM"
                            BackgroundColor="#F0442E"
                            BorderColor="#F0442E"
                            TextColor="White"
                            Style="{StaticResource PillPrimaryButton}"
                            Clicked="OnShopClicked" />
                    <Button Text="ĐƠN HÀNG"
                            Style="{StaticResource PillSecondaryButton}"
                            Clicked="OnTrackOrderClicked" />
                    <Button Text="ĐĂNG XUẤT"
                            Style="{StaticResource PillSecondaryButton}"
                            Clicked="OnLogoutClicked" />
                </HorizontalStackLayout>
            </Grid>

            <FlexLayout Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        AlignContent="Start"
                        BindableLayout.ItemsSource="{Binding Metrics}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:CustomerMetric">
                        <Border BackgroundColor="White"
                                Stroke="#D8E1EB"
                                StrokeThickness="1"
                                Margin="0,0,16,16"
                                WidthRequest="230"
                                Padding="20">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border BackgroundColor="{Binding Accent}"
                                            StrokeThickness="0"
                                            WidthRequest="40"
                                            HeightRequest="40">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Icon}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="White"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               FontFamily="Inter" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="{Binding Subtitle}"
                                           Style="{StaticResource BodyMdLabel}"
                                           FontSize="12"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource LabelCapsLabel}" />
                                <Label Text="{Binding Value}"
                                       FontSize="30"
                                       FontAttributes="Bold"
                                       FontFamily="Inter"
                                       TextColor="{DynamicResource OnSurface}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="20">
                <Border BackgroundColor="White"
                        Stroke="#D8E1EB"
                        StrokeThickness="1"
                        Padding="22">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Đơn gần đây"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   FontSize="20" />
                            <Button Grid.Column="1"
                                    Text="XEM TẤT CẢ"
                                    Style="{StaticResource PillSecondaryButton}"
                                    Clicked="OnTrackOrderClicked" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentOrders}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CustomerOrderCard">
                                    <Border BackgroundColor="#F7FBFF"
                                            Stroke="#D8E1EB"
                                            StrokeThickness="1"
                                            Padding="14">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <Label Text="{Binding Code}"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource OnSurface}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Total}"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#F0442E" />
                                            <Label Grid.Row="1"
                                                   Text="{Binding Date}"
                                                   Style="{StaticResource BodyMdLabel}"
                                                   FontSize="12" />
                                            <Label Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding Accent}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#213145"
                        StrokeThickness="0"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Thông tin khách hàng"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="Inter" />
                        <Label Text="{Binding UserName}"
                               TextColor="White"
                               FontSize="28"
                               FontAttributes="Bold"
                               FontFamily="SourceSerif4"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding UserEmail}"
                               TextColor="#DDEBFF"
                               FontSize="13"
                               FontFamily="Inter"
                               LineBreakMode="TailTruncation" />
                        <BoxView HeightRequest="1" Color="#33FFFFFF" Margin="0,8" />
                        <Label Text="Mua hàng nhanh, theo dõi đơn và quản lý địa chỉ giao hàng trong cùng một khu vực."
                               TextColor="White"
                               FontSize="13"
                               FontFamily="Inter"
                               LineBreakMode="WordWrap" />
                        <Button Text="VÀO GIỎ HÀNG"
                                Style="{StaticResource PillSecondaryButton}"
                                BackgroundColor="White"
                                TextColor="#F0442E"
                                BorderColor="White"
                                Margin="0,10,0,0"
                                Clicked="OnCartClicked" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#D8E1EB"
                    StrokeThickness="1"
                    Padding="22">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Gợi ý mua hàng"
                               Style="{StaticResource HeadlineLgMobileLabel}"
                               FontSize="20" />
                        <Button Grid.Column="1"
                                Text="XEM SẢN PHẨM"
                                BackgroundColor="#F0442E"
                                BorderColor="#F0442E"
                                TextColor="White"
                                Style="{StaticResource PillPrimaryButton}"
                                Clicked="OnShopClicked" />
                    </Grid>
                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                BindableLayout.ItemsSource="{Binding SuggestedProducts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductItem">
                                <Border BackgroundColor="#F7FBFF"
                                        Stroke="#D8E1EB"
                                        StrokeThickness="1"
                                        Padding="14"
                                        WidthRequest="220"
                                        Margin="0,0,12,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <Border BackgroundColor="{Binding BadgeColor}"
                                                StrokeThickness="0"
                                                WidthRequest="46"
                                                HeightRequest="46">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Initials}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontFamily="Inter" />
                                        </Border>
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               FontFamily="Inter"
                                               TextColor="{DynamicResource OnSurface}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Price}"
                                               TextColor="#F0442E"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               FontFamily="Inter" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
