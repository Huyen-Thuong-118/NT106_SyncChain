<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.CustomerHomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SyncChain.Desktop.Views.Pages"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 PAGE HEADER
                 Greeting in HeadlineLgMobileLabel + subtitle in BodyMdLabel
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="Xin chào, Nguyễn Văn Lâm" Style="{StaticResource HeadlineLgMobileLabel}" />
                    <Label Text="Theo dõi đơn hàng, ưu đãi và hỗ trợ khách hàng."
                           Style="{StaticResource BodyMdLabel}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <Button Text="THEO DÕI ĐƠN" Style="{StaticResource PillPrimaryButton}" Clicked="OnTrackOrderClicked" />
                    <Button Text="ĐĂNG XUẤT" Style="{StaticResource PillSecondaryButton}" Clicked="OnLogoutClicked" />
                </HorizontalStackLayout>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 METRICS CARDS
                 GlassCardBorder containers with key customer metrics
            ═══════════════════════════════════════════════════════════════ -->
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Metrics}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:CustomerMetric">
                        <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,20,20" WidthRequest="220" Padding="22">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                                <!-- Icon container -->
                                <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="42" HeightRequest="42">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="11" FontAttributes="Bold" FontFamily="Inter" />
                                </Border>
                                <!-- Subtitle badge -->
                                <Border Grid.Column="1" BackgroundColor="{DynamicResource StatusEmerald}" StrokeThickness="0" HorizontalOptions="End" Padding="10,5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource StatusBadgePill}" TextColor="{DynamicResource Primary}" Padding="0" />
                                </Border>
                                <!-- Metric title -->
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}" Margin="0,18,0,0"
                                       Style="{StaticResource LabelCapsLabel}" />
                                <!-- Large numeric value -->
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Value}" Margin="0,4,0,0"
                                       FontSize="28" FontAttributes="Bold" FontFamily="Inter"
                                       TextColor="{DynamicResource OnSurface}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 ORDER TRACKING + DELIVERY PROFILE
                 Main content area with order timeline and profile sidebar
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="1.3*,0.7*" ColumnSpacing="24">
                <!-- Order Tracking Card -->
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Đơn hàng đang theo dõi" Style="{StaticResource DataTabularLabel}" FontSize="17" />
                                <Label Text="#ORD-2023-8942 đang được chuẩn bị và khóa tồn kho."
                                       Style="{StaticResource BodyMdLabel}" FontSize="13" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" Padding="12,7" VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="CẬP NHẬT 5 PHÚT TRƯỚC" TextColor="{DynamicResource Primary}" FontSize="10" FontAttributes="Bold" FontFamily="Inter" />
                            </Border>
                        </Grid>

                        <!-- Order Timeline -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <VerticalStackLayout Spacing="0">
                                <!-- Step 1: Completed -->
                                <Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" WidthRequest="22" HeightRequest="22">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>
                                </Border>
                                <BoxView WidthRequest="2" HeightRequest="44" Color="{DynamicResource Primary}" HorizontalOptions="Center" />
                                <!-- Step 2: In Progress -->
                                <Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" WidthRequest="22" HeightRequest="22">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>
                                </Border>
                                <BoxView WidthRequest="2" HeightRequest="44" Color="{DynamicResource OutlineVariant}" HorizontalOptions="Center" />
                                <!-- Step 3: Pending -->
                                <Border BackgroundColor="{DynamicResource OutlineVariant}" StrokeThickness="0" WidthRequest="22" HeightRequest="22">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="16">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Đã xác nhận thanh toán" FontAttributes="Bold" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" LineBreakMode="TailTruncation" />
                                    <Label Text="14/10/2023 - 10:25" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Kho đang chuẩn bị và đóng gói" FontAttributes="Bold" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" LineBreakMode="TailTruncation" />
                                    <Label Text="Dự kiến bàn giao vận chuyển trong hôm nay" Style="{StaticResource BodyMdLabel}" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Chờ đơn vị vận chuyển lấy hàng" FontAttributes="Bold" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurfaceVariant}" LineBreakMode="TailTruncation" />
                                    <Label Text="Mã vận đơn sẽ được cập nhật sau khi lấy hàng" Style="{StaticResource BodyMdLabel}" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Payment Summary -->
                            <Border Grid.Column="2" BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" Padding="18" WidthRequest="190" VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Tổng thanh toán" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                                    <Label Text="1,450,000 đ" FontSize="22" FontAttributes="Bold" FontFamily="Inter" TextColor="{DynamicResource Primary}" />
                                    <Label Text="COD khi nhận hàng" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Delivery Profile Card -->
                <Border Grid.Column="1" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" Padding="28">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#14000000" Offset="0,8" Radius="24" Opacity="0.12" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Hồ sơ giao hàng" TextColor="White" FontSize="17" FontAttributes="Bold" FontFamily="Inter" />
                        <Label Text="Nguyễn Văn Lâm" TextColor="White" FontSize="24" FontAttributes="Bold" FontFamily="SourceSerif4" />
                        <Label Text="lam.nv@gmail.com" TextColor="{DynamicResource PrimaryContainer}" FontSize="13" FontFamily="Inter" />
                        <BoxView HeightRequest="1" Color="{DynamicResource GlassBorder30}" Margin="0,8" />
                        <Label Text="ĐỊA CHỈ MẶC ĐỊNH" TextColor="{DynamicResource PrimaryContainer}" FontSize="11" FontAttributes="Bold" FontFamily="Inter" />
                        <Label Text="12 Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh" TextColor="White" FontSize="13" FontFamily="Inter" />
                        <Label Text="SỐ ĐIỆN THOẠI" TextColor="{DynamicResource PrimaryContainer}" FontSize="11" FontAttributes="Bold" FontFamily="Inter" Margin="0,8,0,0" />
                        <Label Text="0901 234 567" TextColor="White" FontSize="13" FontFamily="Inter" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 QUICK ACTIONS + RECENT ORDERS
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="0.95*,1.05*" ColumnSpacing="18">
                <!-- Quick Actions Card -->
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Thao tác nhanh" Style="{StaticResource DataTabularLabel}" FontSize="15" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding QuickActions}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CustomerAction">
                                    <Border BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                                            <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="36" HeightRequest="36">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="10" FontAttributes="Bold" FontFamily="Inter" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" />
                                                <Label Text="{Binding Description}" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Recent Orders Card -->
                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Đơn gần đây" Style="{StaticResource DataTabularLabel}" FontSize="15" />
                            <Label Grid.Column="1" Text="XEM TẤT CẢ" TextColor="{DynamicResource Primary}" FontSize="11" FontAttributes="Bold" FontFamily="Inter" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentOrders}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CustomerOrderCard">
                                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12" Padding="0,6">
                                        <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="O" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" FontFamily="Inter" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Code}" FontAttributes="Bold" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" />
                                            <Label Text="{Binding Date}" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End">
                                            <Label Text="{Binding Total}" FontAttributes="Bold" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding Status}" TextColor="{Binding Accent}" FontSize="11" FontAttributes="Bold" FontFamily="Inter" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 SUGGESTED PRODUCTS + PROMOTIONS
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <!-- Suggested Products Card -->
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Gợi ý mua lại" Style="{StaticResource DataTabularLabel}" FontSize="15" />
                        <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding SuggestedProducts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductItem">
                                    <Border BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="12" WidthRequest="210" Margin="0,0,12,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">
                                            <Border BackgroundColor="{Binding BadgeColor}" StrokeThickness="0" WidthRequest="46" HeightRequest="46">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" FontFamily="Inter" />
                                            </Border>
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" />
                                            <Label Text="{Binding Price}" TextColor="{DynamicResource Primary}" FontAttributes="Bold" FontSize="13" FontFamily="Inter" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Promotions Card -->
                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Ưu đãi của bạn" Style="{StaticResource DataTabularLabel}" FontSize="15" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Promotions}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CustomerPromotion">
                                    <Border BackgroundColor="{DynamicResource SurfaceContainerLow}" StrokeThickness="0" Padding="14">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" Padding="12,8">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Code}" TextColor="White" FontAttributes="Bold" FontSize="11" FontFamily="Inter" />
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding Description}" VerticalTextAlignment="Center" FontSize="13" FontFamily="Inter" TextColor="{DynamicResource OnSurface}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

