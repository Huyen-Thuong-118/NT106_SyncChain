<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.ImportsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SyncChain.Desktop.Models"
             NavigationPage.HasNavigationBar="False">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout>
                    <Label Text="Quản lý phiếu nhập kho" Style="{StaticResource DisplayXlLabel}" />
                    <Label Text="Tạo, duyệt và hoàn tất phiếu trước khi cộng tồn kho."
                           Style="{StaticResource BodyMdLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="TẠO PHIẾU NHẬP"
                        Style="{StaticResource PillPrimaryButton}"
                        VerticalOptions="Center"
                        Clicked="OnCreateReceiptClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout>
                        <Label Text="TỔNG PHIẾU" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="{Binding TotalImports}" Style="{StaticResource DisplayXlLabel}" FontSize="34" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout>
                        <Label Text="TỔNG SỐ LƯỢNG" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="{Binding TotalQuantity}" Style="{StaticResource DisplayXlLabel}" FontSize="34" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout>
                        <Label Text="TỔNG GIÁ TRỊ" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="{Binding TotalAmount}" Style="{StaticResource DisplayXlLabel}" FontSize="34" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout>
                        <Label Text="CHỜ XỬ LÝ" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="{Binding PendingCount}" Style="{StaticResource DisplayXlLabel}" FontSize="34" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="24">
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Tiến độ phiếu nhập"
                                       Style="{StaticResource DataTabularLabel}" FontSize="18" />
                                <Label Text="{Binding SelectedReceiptCode}"
                                       Style="{StaticResource BodyMdLabel}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    BackgroundColor="{Binding SelectedStatusColor}"
                                    StrokeThickness="0" Padding="12,6">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="{Binding SelectedStatusText}"
                                       Style="{StaticResource StatusBadgePill}" Padding="0" />
                            </Border>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReceiptTimeline}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TimelineItem">
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="14" Padding="0,8">
                                        <VerticalStackLayout HorizontalOptions="Center">
                                            <Border WidthRequest="16" HeightRequest="16"
                                                    BackgroundColor="{Binding Accent}" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                            </Border>
                                            <BoxView WidthRequest="2" HeightRequest="28"
                                                     Color="{DynamicResource OutlineVariant}"
                                                     IsVisible="{Binding ShowConnector}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Title}" Style="{StaticResource DataTabularLabel}" />
                                            <Label Text="{Binding Time}" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Thông tin phiếu nhập"
                               Style="{StaticResource DataTabularLabel}" FontSize="18" />
                        <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="18" RowSpacing="12">
                            <Label Text="Nhà cung cấp" Style="{StaticResource BodyMdLabel}" />
                            <Label Grid.Column="1" Text="{Binding SelectedSupplier}" Style="{StaticResource DataTabularLabel}" />
                            <Label Grid.Row="1" Text="Người liên hệ" Style="{StaticResource BodyMdLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedContact}" Style="{StaticResource DataTabularLabel}" />
                            <Label Grid.Row="2" Text="Số mặt hàng" Style="{StaticResource BodyMdLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProductCount}" Style="{StaticResource DataTabularLabel}" />
                            <Label Grid.Row="3" Text="Tổng số lượng" Style="{StaticResource BodyMdLabel}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding SelectedQuantity}" Style="{StaticResource DataTabularLabel}" />
                            <Label Grid.Row="4" Text="Tổng tiền" Style="{StaticResource BodyMdLabel}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAmount}" Style="{StaticResource DataTabularLabel}" />
                        </Grid>
                        <Label Text="{Binding SelectedNote}" Style="{StaticResource BodyMdLabel}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Button Grid.Column="1" Text="{Binding PrimaryActionText}"
                                    IsVisible="{Binding HasPrimaryAction}"
                                    Style="{StaticResource PillPrimaryButton}"
                                    Clicked="OnPrimaryActionClicked" />
                            <Button Grid.Column="2" Text="HỦY PHIẾU"
                                    IsVisible="{Binding CanCancelSelected}"
                                    Style="{StaticResource PillSecondaryButton}"
                                    Clicked="OnCancelReceiptClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Danh sách phiếu nhập" Style="{StaticResource DataTabularLabel}" FontSize="18" />
                        <Button Grid.Column="1" Text="TẢI LẠI"
                                Style="{StaticResource PillSecondaryButton}"
                                Clicked="OnReloadClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="1.2*,1.5*,1.1*,1.1*,1.1*,100"
                          ColumnSpacing="12" Padding="8,0">
                        <Label Text="MÃ PHIẾU" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="1" Text="NHÀ CUNG CẤP" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="2" Text="HÀNG HÓA" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="3" Text="NGÀY TẠO" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="4" Text="TRẠNG THÁI" Style="{StaticResource LabelCapsLabel}" />
                        <Label Grid.Column="5" Text="THAO TÁC" Style="{StaticResource LabelCapsLabel}"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Imports}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ImportItem">
                                <Border BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                        StrokeThickness="0" Padding="8,12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="1.2*,1.5*,1.1*,1.1*,1.1*,100"
                                          ColumnSpacing="12">
                                        <Label Text="{Binding Code}" Style="{StaticResource DataTabularLabel}" />
                                        <Label Grid.Column="1" Text="{Binding Supplier}" Style="{StaticResource DataTabularLabel}" />
                                        <Label Grid.Column="2" Text="{Binding ProductCount}" Style="{StaticResource BodyMdLabel}" />
                                        <Label Grid.Column="3" Text="{Binding Date}" Style="{StaticResource BodyMdLabel}" />
                                        <Border Grid.Column="4" BackgroundColor="{Binding StatusBadgeBackground}"
                                                StrokeThickness="0" Padding="10,5"
                                                HorizontalOptions="Start">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                            <Label Text="{Binding Status}" Style="{StaticResource StatusBadgePill}" Padding="0" />
                                        </Border>
                                        <Button Grid.Column="5" Text="XEM"
                                                Style="{StaticResource PillSecondaryButton}"
                                                CommandParameter="{Binding Id}"
                                                Clicked="OnSelectReceiptClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding PaginationText}" Style="{StaticResource BodyMdLabel}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

        <Grid IsVisible="{Binding IsReceiptFormOpen}"
              BackgroundColor="#99000000"
              Padding="70,40"
              ZIndex="10">
            <Border BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeThickness="1"
                    Padding="24"
                    MaximumWidthRequest="1100"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,*" RowSpacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Tạo phiếu nhập kho"
                                   Style="{StaticResource HeadlineLgMobileLabel}"
                                   FontSize="26" />
                            <Label Text="Nhập đầy đủ thông tin và hàng hóa trước khi tạo phiếu."
                                   Style="{StaticResource BodyMdLabel}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×"
                                Style="{StaticResource PillSecondaryButton}"
                                Padding="14,8" FontSize="20"
                                Clicked="OnCloseReceiptFormClicked" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="16" RowSpacing="14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="NHÀ CUNG CẤP / NGUỒN NHẬP"
                                           Style="{StaticResource LabelCapsLabel}" />
                                    <Entry x:Name="ReceiptSupplierEntry"
                                           Placeholder="Nhập tên nhà cung cấp..." />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="NGƯỜI LIÊN HỆ"
                                           Style="{StaticResource LabelCapsLabel}" />
                                    <Entry x:Name="ReceiptContactEntry"
                                           Placeholder="Tên hoặc số điện thoại..." />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="6">
                                    <Label Text="ĐỊA CHỈ NHÀ CUNG CẤP"
                                           Style="{StaticResource LabelCapsLabel}" />
                                    <Entry x:Name="ReceiptAddressEntry"
                                           Placeholder="Nhập địa chỉ..." />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <Label Text="GHI CHÚ"
                                           Style="{StaticResource LabelCapsLabel}" />
                                    <Entry x:Name="ReceiptNoteEntry"
                                           Placeholder="Ghi chú phiếu nhập..." />
                                </VerticalStackLayout>
                            </Grid>

                            <Border BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                    Stroke="{DynamicResource OutlineVariant}"
                                    StrokeThickness="1" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="THÊM SẢN PHẨM"
                                           Style="{StaticResource LabelCapsLabel}" />
                                    <Grid ColumnDefinitions="*,120,170,Auto"
                                          ColumnSpacing="12">
                                        <Picker x:Name="ReceiptProductPicker"
                                                Title="Chọn sản phẩm"
                                                ItemsSource="{Binding ReceiptProductOptions}"
                                                ItemDisplayBinding="{Binding DisplayText}" />
                                        <Entry x:Name="ReceiptQuantityEntry"
                                               Grid.Column="1"
                                               Placeholder="Số lượng"
                                               Keyboard="Numeric"
                                               Text="1" />
                                        <Entry x:Name="ReceiptUnitCostEntry"
                                               Grid.Column="2"
                                               Placeholder="Đơn giá nhập"
                                               Keyboard="Numeric" />
                                        <Button Grid.Column="3"
                                                Text="+ THÊM"
                                                Style="{StaticResource PillPrimaryButton}"
                                                Clicked="OnAddReceiptLineClicked" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="2*,0.7*,1*,1*,60"
                                  ColumnSpacing="12" Padding="10,0">
                                <Label Text="SẢN PHẨM" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="1" Text="SỐ LƯỢNG" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="2" Text="ĐƠN GIÁ" Style="{StaticResource LabelCapsLabel}" />
                                <Label Grid.Column="3" Text="THÀNH TIỀN" Style="{StaticResource LabelCapsLabel}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                            <Label Text="Chưa có sản phẩm trong phiếu."
                                   IsVisible="{Binding IsReceiptDraftEmpty}"
                                   Style="{StaticResource BodyMdLabel}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,16" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReceiptDraftLines}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ReceiptDraftLine">
                                        <Border BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                                StrokeThickness="0" Padding="10">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="2*,0.7*,1*,1*,60"
                                                  ColumnSpacing="12">
                                                <Label Text="{Binding ProductName}"
                                                       Style="{StaticResource DataTabularLabel}"
                                                       VerticalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation" />
                                                <Entry Grid.Column="1"
                                                       Text="{Binding Quantity, Mode=TwoWay}"
                                                       Keyboard="Numeric"
                                                       Unfocused="OnReceiptLineChanged" />
                                                <Entry Grid.Column="2"
                                                       Text="{Binding UnitCost, Mode=TwoWay}"
                                                       Keyboard="Numeric"
                                                       Unfocused="OnReceiptLineChanged" />
                                                <Label Grid.Column="3"
                                                       Text="{Binding LineTotalText}"
                                                       Style="{StaticResource DataTabularLabel}"
                                                       VerticalTextAlignment="Center" />
                                                <Button Grid.Column="4"
                                                        Text="×"
                                                        Style="{StaticResource PillSecondaryButton}"
                                                        Padding="0"
                                                        CommandParameter="{Binding ProductId}"
                                                        Clicked="OnRemoveReceiptLineClicked" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <VerticalStackLayout>
                                    <Label Text="TỔNG GIÁ TRỊ PHIẾU"
                                           Style="{StaticResource LabelCapsLabel}" />
                                    <Label Text="{Binding ReceiptDraftTotalText}"
                                           Style="{StaticResource DisplayXlLabel}"
                                           FontSize="30" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1"
                                                       Spacing="10"
                                                       VerticalOptions="End">
                                    <Button Text="HỦY"
                                            Style="{StaticResource PillSecondaryButton}"
                                            Clicked="OnCloseReceiptFormClicked" />
                                    <Button Text="TẠO PHIẾU"
                                            Style="{StaticResource PillPrimaryButton}"
                                            Clicked="OnSubmitReceiptFormClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
