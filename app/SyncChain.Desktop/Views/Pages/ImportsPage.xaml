<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.ImportsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="64,30" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 PAGE HEADER
                 "Quản lý Đơn nhập hàng" in DisplayXlLabel + "Tạo Đơn Nhập Mới" PillPrimaryButton
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                <Label Text="Quản lý Đơn nhập hàng" Style="{StaticResource DisplayXlLabel}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="TẠO ĐƠN NHẬP MỚI" Style="{StaticResource PillPrimaryButton}" VerticalOptions="Center" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 4-COLUMN STATISTICS GRID
                 GlassCardBorder containers with DisplayXlLabel numeric values
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="24">
                <!-- Tổng kiện hàng -->
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="TỔNG KIỆN HÀNG" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="1,847" Style="{StaticResource DisplayXlLabel}" FontSize="36" />
                        <Label Text="Tổng số kiện đã nhập" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- Đang trên biển -->
                <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ĐANG TRÊN BIỂN" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="342" Style="{StaticResource DisplayXlLabel}" FontSize="36" TextColor="{DynamicResource Primary}" />
                        <Label Text="Đang vận chuyển" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- Đợi thông quan -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ĐỢI THÔNG QUAN" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="56" Style="{StaticResource DisplayXlLabel}" FontSize="36" />
                        <Label Text="Chờ xử lý hải quan" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- Hoàn tất nhập kho -->
                <Border Grid.Column="3" Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="HOÀN TẤT NHẬP KHO" Style="{StaticResource LabelCapsLabel}" />
                        <Label Text="1,449" Style="{StaticResource DisplayXlLabel}" FontSize="36" TextColor="{DynamicResource Primary}" />
                        <Label Text="Đã nhập kho thành công" Style="{StaticResource BodyMdLabel}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 LIVE TRACKING TIMELINE + MAP/VISUAL SECTION
                 Two-column layout: timeline on left, map on right
            ═══════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="1.2*,*" ColumnSpacing="24">

                <!-- Live Tracking Timeline -->
                <Border Style="{StaticResource GlassCardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Theo dõi trực tiếp" Style="{StaticResource DataTabularLabel}" FontSize="17" />
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource StatusBlue}" StrokeThickness="0" Padding="12,6" HorizontalOptions="End">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="🔴 TRỰC TIẾP" Style="{StaticResource StatusBadgePill}" TextColor="{DynamicResource Primary}" Padding="0" />
                            </Border>
                        </Grid>

                        <!-- Waypoint 1: Completed -->
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                            <Grid WidthRequest="40" HeightRequest="40">
                                <Border BackgroundColor="{DynamicResource StatusEmerald}" StrokeThickness="0" WidthRequest="36" HeightRequest="36"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Label Text="✓" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" TextColor="{DynamicResource Primary}" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Xuất cảng Thượng Hải" Style="{StaticResource DataTabularLabel}" />
                                <Label Text="12/01/2025 – Hoàn tất" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                            </VerticalStackLayout>
                            <!-- Vertical connector line -->
                            <BoxView Grid.Row="1" WidthRequest="2" HeightRequest="24" Color="{DynamicResource StatusEmerald}"
                                     HorizontalOptions="Center" VerticalOptions="Start" Margin="0,4,0,0" />
                        </Grid>

                        <!-- Waypoint 2: Completed -->
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                            <Grid WidthRequest="40" HeightRequest="40">
                                <Border BackgroundColor="{DynamicResource StatusEmerald}" StrokeThickness="0" WidthRequest="36" HeightRequest="36"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Label Text="✓" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" TextColor="{DynamicResource Primary}" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Quá cảnh Singapore" Style="{StaticResource DataTabularLabel}" />
                                <Label Text="15/01/2025 – Hoàn tất" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                            </VerticalStackLayout>
                            <!-- Vertical connector line -->
                            <BoxView Grid.Row="1" WidthRequest="2" HeightRequest="24" Color="{DynamicResource StatusBlue}"
                                     HorizontalOptions="Center" VerticalOptions="Start" Margin="0,4,0,0" />
                        </Grid>

                        <!-- Waypoint 3: In-Transit (active) -->
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                            <Grid WidthRequest="40" HeightRequest="40">
                                <Border BackgroundColor="{DynamicResource StatusBlue}" StrokeThickness="0" WidthRequest="36" HeightRequest="36"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Label Text="🚢" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Đang trên biển – Biển Đông" Style="{StaticResource DataTabularLabel}" TextColor="{DynamicResource Primary}" />
                                <Label Text="Dự kiến: 20/01/2025" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                            </VerticalStackLayout>
                            <!-- Vertical connector line -->
                            <BoxView Grid.Row="1" WidthRequest="2" HeightRequest="24" Color="{DynamicResource OutlineVariant}"
                                     HorizontalOptions="Center" VerticalOptions="Start" Margin="0,4,0,0" />
                        </Grid>

                        <!-- Waypoint 4: Pending -->
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                            <Grid WidthRequest="40" HeightRequest="40">
                                <Border BackgroundColor="{DynamicResource StatusSlate}" StrokeThickness="0" WidthRequest="36" HeightRequest="36"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Label Text="○" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" TextColor="{DynamicResource OnSurfaceVariant}" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Cảng Cát Lái – Thông quan" Style="{StaticResource DataTabularLabel}" TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="Chờ xử lý" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                            </VerticalStackLayout>
                            <!-- Vertical connector line -->
                            <BoxView Grid.Row="1" WidthRequest="2" HeightRequest="24" Color="{DynamicResource OutlineVariant}"
                                     HorizontalOptions="Center" VerticalOptions="Start" Margin="0,4,0,0" />
                        </Grid>

                        <!-- Waypoint 5: Pending -->
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="16">
                            <Grid WidthRequest="40" HeightRequest="40">
                                <Border BackgroundColor="{DynamicResource StatusSlate}" StrokeThickness="0" WidthRequest="36" HeightRequest="36"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Label Text="○" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" TextColor="{DynamicResource OnSurfaceVariant}" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Nhập kho SyncChain" Style="{StaticResource DataTabularLabel}" TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="Chờ xử lý" Style="{StaticResource BodyMdLabel}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Map/Visual Section -->
                <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceContainerHigh}" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Grid>
                        <!-- Background gradient fill simulating map -->
                        <BoxView>
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#dce9ff" Offset="0.0" />
                                    <GradientStop Color="#e0f2fe" Offset="0.4" />
                                    <GradientStop Color="#d3e4fe" Offset="1.0" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <!-- Map placeholder content -->
                        <Label Text="🗺️" FontSize="64" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.3" />

                        <!-- Overlay GlassCardBorder showing vessel info -->
                        <Border Style="{StaticResource GlassCardBorder}" Margin="16" VerticalOptions="End" HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{DynamicResource PrimaryContainer}" StrokeThickness="0" WidthRequest="42" HeightRequest="42">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="🚢" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="MV Pacific Star" Style="{StaticResource DataTabularLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="IMO: 9876543" Style="{StaticResource BodyMdLabel}" FontSize="11" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="{DynamicResource StatusBlue}" StrokeThickness="0" Padding="10,4" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="TRÊN BIỂN" Style="{StaticResource StatusBadgePill}" TextColor="{DynamicResource Primary}" Padding="0" />
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="TỐC ĐỘ" Style="{StaticResource LabelCapsLabel}" />
                                        <Label Text="14.2 hải lý/h" Style="{StaticResource DataTabularLabel}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ETA" Style="{StaticResource LabelCapsLabel}" />
                                        <Label Text="20/01/2025" Style="{StaticResource DataTabularLabel}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 SHIPMENT TABLE
                 GlassCardBorder with columns: "Mã vận đơn", "Nhà cung cấp",
                 "Hàng hóa", "Ngày đến (dự kiến)", "Trạng thái", "Quản lý"
            ═══════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource GlassCardBorder}">
                <VerticalStackLayout Spacing="16">
                    <!-- Table title -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Danh sách vận đơn nhập hàng" Style="{StaticResource DataTabularLabel}" FontSize="17" />
                        <Button Grid.Column="1" Text="LỌC DỮ LIỆU" Style="{StaticResource PillSecondaryButton}" Padding="18,10" />
                    </Grid>

                    <!-- Table header -->
                    <Grid ColumnDefinitions="1.2*,1.5*,1.5*,1.2*,1.2*,Auto" ColumnSpacing="12" Padding="8,0">
                        <Label Text="Mã vận đơn" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="1" Text="Nhà cung cấp" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2" Text="Hàng hóa" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="3" Text="Ngày đến (dự kiến)" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="4" Text="Trạng thái" Style="{StaticResource LabelCapsLabel}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="5" Text="Quản lý" Style="{StaticResource LabelCapsLabel}" WidthRequest="80" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                    </Grid>
                    <!-- Separator -->
                    <BoxView HeightRequest="1" Color="{DynamicResource OutlineVariant}" />

                    <!-- Import rows -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Imports}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="8,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="1.2*,1.5*,1.5*,1.2*,1.2*,Auto" ColumnSpacing="12">
                                        <!-- Mã vận đơn -->
                                        <Label Text="{Binding Code}" Style="{StaticResource DataTabularLabel}"
                                               TextColor="{DynamicResource Primary}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <!-- Nhà cung cấp -->
                                        <Label Grid.Column="1" Text="{Binding Supplier}" Style="{StaticResource DataTabularLabel}"
                                               VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <!-- Hàng hóa (ProductCount) -->
                                        <Label Grid.Column="2" Text="{Binding ProductCount}" Style="{StaticResource DataTabularLabel}"
                                               VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <!-- Ngày đến (dự kiến) -->
                                        <Label Grid.Column="3" Text="{Binding Date}" Style="{StaticResource DataTabularLabel}"
                                               VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <!-- Trạng thái - StatusBadgePill -->
                                        <Border Grid.Column="4" BackgroundColor="{Binding StatusBadgeBackground}" StrokeThickness="0"
                                                Padding="12,4" HorizontalOptions="Start" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Status}" Style="{StaticResource StatusBadgePill}" Padding="0" LineBreakMode="TailTruncation" />
                                        </Border>
                                        <!-- Quản lý button -->
                                        <Button Grid.Column="5" Text="CHI TIẾT" Style="{StaticResource PillSecondaryButton}"
                                                Padding="14,8" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Pagination -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="Hiển thị 1 – 5 trong số 342 vận đơn" Style="{StaticResource BodyMdLabel}" VerticalTextAlignment="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <Button Text="TRƯỚC" Style="{StaticResource PillSecondaryButton}" Padding="18,10" />
                            <Button Text="1" Style="{StaticResource PillPrimaryButton}" Padding="14,10" />
                            <Button Text="2" Style="{StaticResource PillSecondaryButton}" Padding="14,10" />
                            <Button Text="3" Style="{StaticResource PillSecondaryButton}" Padding="14,10" />
                            <Button Text="TIẾP" Style="{StaticResource PillSecondaryButton}" Padding="18,10" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

