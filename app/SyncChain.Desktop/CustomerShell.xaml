<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SyncChain.Desktop.CustomerShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:SyncChain.Desktop.Views.Pages"
    FlyoutBackgroundColor="#66e0f2fe"
    FlyoutBehavior="Flyout"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.UnselectedColor="{StaticResource OnSurfaceVariant}">

    <Shell.FlyoutHeader>
        <Grid Padding="24,32,24,20">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <!-- Logo icon container: primary bg, rounded-xl, white icon -->
                <Border BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        WidthRequest="44"
                        HeightRequest="44">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="&#xe7ef;"
                           FontFamily="MaterialSymbols"
                           FontSize="24"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <!-- Brand name in SourceSerif4 -->
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="SyncChain"
                           FontFamily="SourceSerif4"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" />
                    <Label Text="CỔNG KHÁCH HÀNG"
                           FontFamily="Inter"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextTransform="Uppercase"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           CharacterSpacing="1.8" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"
                  Padding="20,12" Margin="8,2"
                  HeightRequest="44">
                <Label Grid.Column="0"
                       Text="{Binding FlyoutIcon}"
                       FontFamily="MaterialSymbols"
                       FontSize="20"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontFamily="Inter"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextTransform="Uppercase"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Trang khách hàng" Route="customer-home">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource FontFamily="MaterialSymbols" Glyph="&#xe88a;" Color="{StaticResource OnSurfaceVariant}" Size="20" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate pages:CustomerHomePage}" />
    </FlyoutItem>
</Shell>
