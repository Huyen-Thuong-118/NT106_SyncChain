<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView Background="{StaticResource AppPageBackgroundBrush}">
        <VerticalStackLayout Padding="30" Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="QUẢN LÝ ĐƠN HÀNG" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="Theo dõi, xem chi tiết và xử lý trạng thái đơn hàng." Style="{StaticResource CaptionLabel}" FontSize="14" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ Tạo đơn hàng mới" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnCreateOrderClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="TỔNG ĐƠN HÀNG" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="TotalOrdersLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="ĐƠN CHỜ" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="PendingOrdersLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="HOÀN TẤT" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="DoneOrdersLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="HỦY ĐƠN" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="CancelOrdersLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Tất cả" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnRefreshClicked" />
                            <Button Text="Làm mới" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnRefreshClicked" />
                        </HorizontalStackLayout>
                        <Label x:Name="ScopeLabel" Grid.Column="1" Text="Đang tải..." Style="{StaticResource CaptionLabel}" VerticalTextAlignment="Center" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="18">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="110,2.2*,1.1*,1*,Auto,Auto" ColumnSpacing="16">
                                        <Label Text="{Binding Code}" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" VerticalTextAlignment="Center" />
                                        <Grid Grid.Column="1" ColumnDefinitions="54,*" ColumnSpacing="12">
                                            <Border BackgroundColor="#E8F1FF" StrokeThickness="0" WidthRequest="46" HeightRequest="46">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="15" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Customer}" FontAttributes="Bold" />
                                                <Label Text="{Binding Email}" Style="{StaticResource CaptionLabel}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Grid.Column="2" Text="{Binding CreatedAt}" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="{Binding Total}" VerticalTextAlignment="Center" FontAttributes="Bold" />
                                        <Border Grid.Column="4" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" Padding="10,4" HorizontalOptions="End" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="999" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Status}" TextColor="White" />
                                        </Border>
                                        <Button Grid.Column="5" Text="Chi tiết" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnOpenDetailClicked" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label x:Name="EmptyLabel" Text="Chưa có đơn hàng nào." Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" IsVisible="False" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
