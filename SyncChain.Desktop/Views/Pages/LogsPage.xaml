<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView Background="{StaticResource AppPageBackgroundBrush}">
        <VerticalStackLayout Padding="30" Spacing="24">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="NHẬT KÝ HOẠT ĐỘNG" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="Theo dõi các thao tác quan trọng trong hệ thống." Style="{StaticResource CaptionLabel}" FontSize="14" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Xuất CSV" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnExportClicked" />
                <Button Grid.Column="2" Text="Làm mới" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnRefreshClicked" />
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnDefinitions="2*,Auto" ColumnSpacing="12">
                    <Border BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="14,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" HeightRequest="42">
                            <Label Text="⌕" VerticalTextAlignment="Center" TextColor="{StaticResource MutedColor}" />
                            <Entry x:Name="SearchEntry"
                                   Grid.Column="1"
                                   Placeholder="Tìm theo tiêu đề, mô tả, loại hoạt động..."
                                   BackgroundColor="Transparent"
                                   TextChanged="OnSearchTextChanged" />
                        </Grid>
                    </Border>
                    <Picker x:Name="TagPicker"
                            Grid.Column="1"
                            Title="Loại hoạt động"
                            SelectedIndexChanged="OnTagChanged"
                            WidthRequest="180">
                        <Picker.Items>
                            <x:String>Tất cả</x:String>
                            <x:String>Đơn hàng</x:String>
                            <x:String>Kho hàng</x:String>
                            <x:String>Người dùng</x:String>
                        </Picker.Items>
                    </Picker>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="TỔNG HOẠT ĐỘNG" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="TotalLogsLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="HOẠT ĐỘNG HÔM NAY" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="TodayLogsLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="ĐANG HIỂN THỊ" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="FilteredLogsLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="LogsSubtitleLabel" Text="Đang tải nhật ký..." Style="{StaticResource CaptionLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Logs}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                                    <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="46" HeightRequest="46">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding Description}" Style="{StaticResource CaptionLabel}" />
                                        <Label Text="{Binding Time}" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="{Binding Accent}" StrokeThickness="0" Padding="10,4" HorizontalOptions="End" VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="999" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Tag}" TextColor="White" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
