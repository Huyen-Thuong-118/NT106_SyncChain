<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.UserAccessPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView Background="{StaticResource AppPageBackgroundBrush}">
        <VerticalStackLayout Padding="30" Spacing="22">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="NGƯỜI DÙNG VÀ PHÂN QUYỀN" Style="{StaticResource PageTitleLabel}" />
                    <Label x:Name="RoleHintLabel" Text="Chỉ admin được quản lý tài khoản manager/staff." Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Làm mới" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnRefreshClicked" />
                <Button Grid.Column="2" Text="Đăng xuất" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnLogoutClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="Tổng nội bộ" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="TotalUsersLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="Manager" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="ManagerUsersLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="Staff" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="StaffUsersLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout>
                        <Label Text="Đang khóa" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="LockedUsersLabel" Text="0" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="0.9*,1.1*" ColumnSpacing="18">
                <Border x:Name="CreatePanel" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Tạo tài khoản nội bộ" Style="{StaticResource SectionTitleLabel}" />
                        <Label Text="Admin tạo tài khoản manager hoặc staff. Khách hàng tự đăng ký ở màn hình Đăng ký." Style="{StaticResource CaptionLabel}" />

                        <Entry x:Name="UsernameEntry" Placeholder="Tên hiển thị / username" />
                        <Entry x:Name="EmailEntry" Placeholder="Email công việc" Keyboard="Email" />
                        <Entry x:Name="PasswordEntry" Placeholder="Mật khẩu tạm thời" IsPassword="True" Text="123456" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button x:Name="ManagerRoleButton" Text="Manager" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnManagerRoleClicked" />
                            <Button x:Name="StaffRoleButton" Grid.Column="1" Text="Staff" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnStaffRoleClicked" />
                        </Grid>

                        <Button x:Name="CreateUserButton" Text="Tạo tài khoản" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnCreateUserClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Danh sách manager/staff" Style="{StaticResource SectionTitleLabel}" />
                            <Label x:Name="PermissionLabel" Grid.Column="1" Text="-" Style="{StaticResource CaptionLabel}" VerticalTextAlignment="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="1.1*,1.4*,0.7*,0.8*,Auto,Auto,Auto" Padding="10,0">
                            <Label Text="Mã" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="Email" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="2" Text="Role" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="3" Text="Trạng thái" Style="{StaticResource CaptionLabel}" />
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Users}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#F4F6F8" StrokeThickness="0" Padding="10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="1.1*,1.4*,0.7*,0.8*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Code}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Email}" FontAttributes="Bold" />
                                                <Label Text="{Binding Username}" Style="{StaticResource CaptionLabel}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding RoleLabel}" VerticalTextAlignment="Center" />
                                            <Label Grid.Column="3" Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                            <Button Grid.Column="4" Text="Đổi role" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnChangeRoleClicked" CommandParameter="{Binding .}" />
                                            <Button Grid.Column="5" Text="{Binding ToggleText}" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnToggleActiveClicked" CommandParameter="{Binding .}" />
                                            <Button Grid.Column="6" Text="Reset mật khẩu" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnResetPasswordClicked" CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label x:Name="EmptyLabel" Text="Chưa có tài khoản manager/staff." Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
