<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.OrderDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView Background="{StaticResource AppPageBackgroundBrush}">
        <VerticalStackLayout Padding="30" Spacing="24">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button Text="Quay lại danh sách" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1">
                    <Label x:Name="OrderTitleLabel" Text="ĐƠN HÀNG" Style="{StaticResource PageTitleLabel}" />
                    <Label x:Name="OrderSubtitleLabel" Text="Đang tải chi tiết đơn hàng..." Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
                <Picker x:Name="StatusPicker" Grid.Column="2" Title="Trạng thái" WidthRequest="160" IsVisible="False">
                    <Picker.Items>
                        <x:String>pending</x:String>
                        <x:String>processing</x:String>
                        <x:String>done</x:String>
                        <x:String>cancel</x:String>
                    </Picker.Items>
                </Picker>
                <Button x:Name="UpdateStatusButton"
                        Grid.Column="3"
                        Text="Cập nhật"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnUpdateStatusClicked"
                        IsVisible="False" />
            </Grid>

            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="18">
                <VerticalStackLayout Spacing="18">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Sản phẩm trong đơn" Style="{StaticResource SectionTitleLabel}" />
                                <Label x:Name="LineCountLabel" Grid.Column="1" Text="0 sản phẩm" Style="{StaticResource CaptionLabel}" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="12">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="14">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="72,*,Auto,Auto,Auto" ColumnSpacing="14">
                                                <Border BackgroundColor="#E8EDF4" StrokeThickness="0" WidthRequest="62" HeightRequest="62">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                    <Label Text="{Binding Variant}" Style="{StaticResource CaptionLabel}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding Quantity}" VerticalTextAlignment="Center" />
                                                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center">
                                                    <Label Text="{Binding UnitPrice}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                                    <Label Text="Đơn giá" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="4" VerticalOptions="Center">
                                                    <Label Text="{Binding LineTotal}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                                    <Label Text="Thành tiền" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label x:Name="EmptyLinesLabel" Text="Đơn hàng chưa có chi tiết." Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" IsVisible="False" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="18">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Trạng thái" Style="{StaticResource SectionTitleLabel}" />
                            <Border x:Name="StatusBadge" BackgroundColor="Orange" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                                <Label x:Name="StatusLabel" Text="pending" TextColor="White" />
                            </Border>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Mã đơn" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="OrderCodeLabel" Grid.Column="1" Text="-" FontAttributes="Bold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Tổng tiền" Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="TotalLabel" Grid.Column="1" Text="0 VND" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Ghi chú" Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="Ghi chú giao hàng." Style="{StaticResource CaptionLabel}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
