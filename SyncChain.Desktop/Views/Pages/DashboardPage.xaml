<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">
    <ScrollView Background="{StaticResource AppPageBackgroundBrush}">
        <VerticalStackLayout Padding="30" Spacing="24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout>
                    <Label Text="TỔNG QUAN" Style="{StaticResource PageTitleLabel}" />
                    <Label x:Name="SubtitleLabel" Text="Thống kê đơn hàng, doanh thu và sản phẩm bán." Style="{StaticResource CaptionLabel}" FontSize="14" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Làm mới" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnRefreshClicked" />
            </Grid>

            <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Stats}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,18,18" WidthRequest="226" Padding="22">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                                <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="42" HeightRequest="42">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Subtitle}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource SuccessColor}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}" Margin="0,20,0,0" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryColor}" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Value}" Margin="0,4,0,0" FontSize="24" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="18">
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Xu hướng đơn hàng 7 ngày" Style="{StaticResource SectionTitleLabel}" />
                        <Grid ColumnDefinitions="*,*,*,*,*" Padding="0,0,0,8">
                            <Label Text="Ngay" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Text="Tổng đơn" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="2" Text="Hoàn thành" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="3" Text="Đang xử lý" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="4" Text="Doanh thu" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="End" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrderTrend}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#F4F6F8" StrokeThickness="0" Padding="12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,*,*,*,*">
                                            <Label Text="{Binding Label}" FontAttributes="Bold" />
                                            <Label Grid.Column="1" Text="{Binding Orders}" />
                                            <Label Grid.Column="2" Text="{Binding Completed}" TextColor="{StaticResource SuccessColor}" FontAttributes="Bold" />
                                            <Label Grid.Column="3" Text="{Binding Processing}" TextColor="{StaticResource WarningColor}" FontAttributes="Bold" />
                                            <Label Grid.Column="4" Text="{Binding Revenue}" HorizontalTextAlignment="End" FontAttributes="Bold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="{StaticResource SidebarColor}" StrokeThickness="0" Padding="28">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Phân bổ sản phẩm" TextColor="White" FontSize="17" FontAttributes="Bold" />
                        <Label x:Name="InventorySubtitleLabel" Text="-" TextColor="#B7CDF8" FontSize="13" />
                        <Grid HorizontalOptions="Center" Margin="0,18,0,6">
                            <Border BackgroundColor="White" StrokeThickness="0" WidthRequest="140" HeightRequest="140">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="70" />
                                </Border.StrokeShape>
                            </Border>
                            <Border BackgroundColor="{StaticResource SidebarColor}" StrokeThickness="0" WidthRequest="98" HeightRequest="98" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="49" />
                                </Border.StrokeShape>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                    <Label x:Name="InventoryPercentLabel" Text="0%" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                    <Label Text="ĐANG BÁN" TextColor="#C8D9FF" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label Text="Sản phẩm bán chạy" TextColor="White" FontSize="15" FontAttributes="Bold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopProducts}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <Label Text="{Binding Name}" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="{Binding Quantity}" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                        <Label Grid.Row="1" Text="{Binding Code}" TextColor="#B7CDF8" FontSize="11" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Revenue}" TextColor="#B7CDF8" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Cảnh báo tồn kho thấp" Style="{StaticResource SectionTitleLabel}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Alerts}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#F4F6F8" StrokeThickness="0" Padding="10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14">
                                            <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="48" HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Code}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" />
                                                <Label Text="{Binding Code}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryColor}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding StockText}" TextColor="{Binding Accent}" FontSize="12" FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label x:Name="EmptyAlertsLabel" Text="Không có sản phẩm sắp hết hàng." Style="{StaticResource CaptionLabel}" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Hoạt động gần đây" Style="{StaticResource SectionTitleLabel}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Activities}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="30,*" ColumnSpacing="16">
                                        <Border BackgroundColor="{Binding Accent}" StrokeThickness="0" WidthRequest="24" HeightRequest="24">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="7" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="10" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="13" />
                                            <Label Text="{Binding Time}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryColor}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
