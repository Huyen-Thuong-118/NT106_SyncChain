<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SyncChain.Desktop.Views.Pages.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Đăng ký"
             NavigationPage.HasNavigationBar="False">
    <Grid Padding="28" BackgroundColor="#0E1420">
        <Border BackgroundColor="{StaticResource SurfaceColor}" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="1240">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="1.05*,0.95*">
                <Grid BackgroundColor="#11284E" Padding="34" RowDefinitions="Auto,Auto,*,Auto">
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="#1A3F72" StrokeThickness="0" WidthRequest="42" HeightRequest="42">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="⟠" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                        </Border>
                        <Label Text="SUPPLY CHAIN" VerticalTextAlignment="Center" TextColor="White" FontAttributes="Bold" CharacterSpacing="1.6" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Margin="0,48,0,0" Spacing="10">
                        <Label Text="HỆ THỐNG LOGISTICS TVT" TextColor="#A7C2F5" FontSize="12" CharacterSpacing="2" />
                        <Label Text="Chính xác&#10;trong từng&#10;lô hàng." TextColor="White" FontSize="42" FontAttributes="Bold" />
                        <Label Text="Join the most advanced logistical network designed for the modern industrial monolith. Manage fleet, inventory, and global shipping with editorial clarity." TextColor="#D7E6FF" FontSize="16" MaximumWidthRequest="360" />
                    </VerticalStackLayout>

                    <Border Grid.Row="2" BackgroundColor="#17376A" StrokeThickness="0" Margin="0,28,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                    </Border>

                    <VerticalStackLayout Grid.Row="3" Spacing="8">
                        <BoxView HeightRequest="2" WidthRequest="140" Color="#93B3EF" />
                        <Label Text="TIÊU CHUẨN CHUỖI CUNG ỨNG TOÀN CẦU V4.0" TextColor="#93B3EF" FontSize="11" CharacterSpacing="1.5" />
                    </VerticalStackLayout>
                </Grid>

                <ScrollView Grid.Column="1">
                    <VerticalStackLayout Padding="42" Spacing="14">
                        <Label Text="Đăng ký" Style="{StaticResource PageTitleLabel}" />
                        <Label Text="Nhập thông tin đăng ký để truy cập hệ thống" Style="{StaticResource CaptionLabel}" />

                        <Label Text="HỌ VÀ TÊN" Style="{StaticResource CaptionLabel}" />
                        <Entry x:Name="FullNameEntry" Placeholder="Jonhathan Doe" />

                        <Label Text="EMAIL" Style="{StaticResource CaptionLabel}" />
                        <Entry x:Name="EmailEntry" Placeholder="j.doe@logistics-kinetic.com" Keyboard="Email" />

                        <Label Text="TÊN ĐĂNG NHẬP" Style="{StaticResource CaptionLabel}" />
                        <Entry x:Name="UsernameEntry" Placeholder="jdoe_monolith" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="MẬT KHẨU" Style="{StaticResource CaptionLabel}" />
                                <Entry x:Name="PasswordEntry" Placeholder="••••••••" IsPassword="True" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="XÁC NHẬN MẬT KHẨU" Style="{StaticResource CaptionLabel}" />
                                <Entry x:Name="ConfirmPasswordEntry" Placeholder="••••••••" IsPassword="True" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,6,0,0">
                            <CheckBox IsChecked="True" />
                            <Label Grid.Column="1" Text="Tôi đồng ý với điều khoản dịch vụ và chính sách quản trị của hệ thống." VerticalTextAlignment="Center" />
                        </Grid>

                        <Button x:Name="RegisterButton" Text="ĐĂNG KÝ →" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnRegisterClicked" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="Đã có tài khoản?" />
                            <Label Text="Đăng nhập" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="18" Margin="0,12,0,0">
                            <Label Text="TRUNG TÂM HỖ TRỢ" Style="{StaticResource CaptionLabel}" />
                            <Label Text="THÔNG SỐ KỸ THUẬT" Style="{StaticResource CaptionLabel}" />
                            <Label Text="TRẠNG THÁI HỆ THỐNG" Style="{StaticResource CaptionLabel}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
